@inherits LayoutComponentBase

<div class="register-shell">
    <header class="register-header">
        <a class="brand" href="/" aria-label="HotJob home">
            <span class="brand-mark">hot</span><span>job</span>
        </a>

        <nav class="header-links" aria-label="Primary navigation">
            <a href="/">Jobs</a>
            <a href="/">Companies</a>
            <a href="/">Salary Report</a>
        </nav>

        <div class="header-actions">
            <a class="sign-in" href="/login">Sign In</a>
        </div>
    </header>

    <main class="register-content">
        @Body
    </main>

    <footer class="register-footer">
        <div class="footer-brand">
            <strong>hotjob</strong>
            <a href="/">About Us</a>
            <a href="/">Contact Us</a>
            <a href="/">All Jobs</a>
        </div>
        <div class="footer-column">
            <strong>Campaign</strong>
            <a href="/">Best Companies</a>
            <a href="/">Company Reviews</a>
        </div>
        <div class="footer-column">
            <strong>Terms</strong>
            <a href="/">Privacy Policy</a>
            <a href="/">Terms &amp; Conditions</a>
        </div>
        <div class="footer-column">
            <strong>Contact</strong>
            <a href="mailto:hello@hotjob.local">Ho Chi Minh: (+84) 977 460 519</a>
            <a href="mailto:love@hotjob.local">love@hotjob.local</a>
        </div>
        <div class="footer-bottom">Copyright © HotJob · Find work that fits.</div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
