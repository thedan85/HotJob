@rendermode InteractiveServer
@inject HotJobAuthStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using hotjob.Services.Authentication

<header class="top-row">
    <div class="nav-inner">
        <a class="navbar-brand" href="" aria-label="HotJob home">
            <span class="brand-hot">hot</span><span>job</span>
        </a>

        <button class="menu-toggle" type="button" @onclick="ToggleMenu" aria-expanded="@menuOpen"
                aria-controls="site-menu" aria-label="@(menuOpen ? "Close navigation" : "Open navigation")">
            <span></span><span></span><span></span>
        </button>

        <nav id="site-menu" class="nav-scrollable @(menuOpen ? "is-open" : string.Empty)"
             aria-label="Primary navigation" @onclick="CloseMenu">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="nav-link" href="companies">Companies</NavLink>
            <NavLink class="nav-link" href="it-jobs">Explore jobs</NavLink>

            <AuthorizeView>
                <Authorized Context="navAuth">
                    @if (!navAuth.User.IsInRole("Employer"))
                    {
                        <NavLink class="nav-link" href="become-employer">Become an employer</NavLink>
                    }
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Employer">
                <Authorized Context="employerAuth">
                    <span class="nav-group-label">Employer</span>
                    <NavLink class="nav-link nav-link-employer" href="employer/jobs">My jobs</NavLink>
                    <NavLink class="nav-link nav-link-employer" href="employer/candidates">Candidates</NavLink>
                    <NavLink class="nav-link nav-link-employer" href="employer/interviews">Applicants</NavLink>
                    <NavLink class="nav-link nav-link-employer" href="employer/company">Company</NavLink>
                    <NavLink class="nav-link nav-link-employer" href="employer/billing">Billing</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Candidate">
                <Authorized>
                    <NavLink class="nav-link" href="my-applications">My applications</NavLink>
                    <NavLink class="nav-link" href="job-alerts">Job alerts</NavLink>
                    <NavLink class="nav-link" href="premium">Go premium</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="nav-actions">
            <AuthorizeView>
                <Authorized Context="authState">
                    <a class="nav-user" href="@(authState.User.IsInRole("Employer") ? "/employer/company" : "/profile")"
                       title="@(authState.User.IsInRole("Employer") ? "View your company" : "View your profile")">
                        <span class="nav-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="3.5" />
                                <path d="M5 19.2c1.2-3.3 3.9-5.2 7-5.2s5.8 1.9 7 5.2" />
                            </svg>
                        </span>
                        <span class="nav-user-name">@authState.User.Identity?.Name</span>
                    </a>
                    <button class="nav-sign-out" type="button" @onclick="SignOutAsync">Sign out</button>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-sign-in" href="/login">Sign in</a>
                    <a class="nav-get-started" href="/register">Get started</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private bool menuOpen;

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var result = await JS.InvokeAsync<AuthApiResult>("hotjobAuth.me");
            if (result.Ok && result.Data is not null)
            {
                AuthStateProvider.SignIn(result.ToTokens());
            }
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            // JS interop unavailable during prerender; the interactive pass retries.
        }
    }

    private async Task SignOutAsync()
    {
        try
        {
            var result = await JS.InvokeAsync<AuthApiResult>("hotjobAuth.logout");
            if (result.Ok || result.Status == 401)
            {
                AuthStateProvider.SignOut();
                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            // Network/JS failure: keep the session so the user can retry sign out.
        }
    }
}
