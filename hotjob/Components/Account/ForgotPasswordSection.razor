@using hotjob.Services.Account.PasswordRecovery
@using hotjob.Services.Common
@inject IPasswordResetService PasswordResetService
@inject CircuitDbGate CircuitDbGate
@inject NavigationManager NavigationManager
@inject ILogger<ForgotPasswordSection> Logger

<EditForm Model="form" OnValidSubmit="SubmitAsync" class="login-form" aria-busy="@(isSubmitting ? "true" : "false")">
    <DataAnnotationsValidator />
    <div class="field-group">
        <label for="forgot-email">Email (required)</label>
        <InputText id="forgot-email" type="email" @bind-Value="form.Email" autocomplete="email"
                   maxlength="254" aria-required="true" aria-describedby="forgot-email-error" disabled="@isSubmitting" />
        <div id="forgot-email-error" aria-live="polite"><ValidationMessage For="() => form.Email" /></div>
    </div>
    @if (submitted)
    {
        <div class="form-message success" role="status">@hotjob.Services.Account.PasswordRecovery.PasswordResetService.RequestNotice</div>
    }
    <button class="submit-button" type="submit" disabled="@isSubmitting">
        @(isSubmitting ? "Requesting link..." : "Send reset link")
    </button>
</EditForm>
<p class="login-prompt"><a href="/login">Back to sign in</a></p>

@code {
    private readonly ForgotPasswordForm form = new();
    private bool isSubmitting;
    private bool submitted;

    private async Task SubmitAsync()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        try
        {
            await CircuitDbGate.RunAsync(() => PasswordResetService.RequestPasswordResetAsync(form.Email, NavigationManager.BaseUri));
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Password recovery request failed ({FailureType}).", exception.GetType().Name);
        }
        finally
        {
            submitted = true;
            isSubmitting = false;
        }
    }
}
