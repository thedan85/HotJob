@using System.Security.Claims
@using hotjob.DTOs.Authentication
@using hotjob.Services.Common
@inject IAccountService AccountService
@inject HotJobAuthStateProvider AuthStateProvider
@inject CircuitDbGate CircuitDbGate
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<ChangePasswordSection> Logger

<section id="change-password" class="profile-box" aria-labelledby="change-password-title">
    <div class="profile-box-heading">
        <div>
            <h2 id="change-password-title">Change password</h2>
            <p id="change-password-help">After changing your password, you will be signed out. Sign in again with your new password.</p>
        </div>
    </div>
    <EditForm Model="form" OnValidSubmit="SubmitAsync" @key="form"
              aria-describedby="change-password-help" aria-busy="@(isSubmitting ? "true" : "false")">
        <DataAnnotationsValidator />
        <div class="profile-form-grid">
            <div class="profile-field-wide">
                <label for="current-password">
                    Current password (required)
                    <InputText id="current-password" type="password" @bind-Value="form.CurrentPassword"
                               autocomplete="current-password" aria-required="true"
                               aria-describedby="current-password-error" disabled="@isSubmitting" />
                </label>
                <div id="current-password-error" aria-live="polite">
                    <ValidationMessage For="() => form.CurrentPassword" />
                </div>
            </div>
            <div>
                <label for="new-password">
                    New password (required)
                    <InputText id="new-password" type="password" @bind-Value="form.NewPassword"
                               autocomplete="new-password" aria-required="true"
                               aria-describedby="new-password-error" disabled="@isSubmitting" />
                </label>
                <div id="new-password-error" aria-live="polite">
                    <ValidationMessage For="() => form.NewPassword" />
                </div>
            </div>
            <div>
                <label for="confirm-new-password">
                    Confirm new password (required)
                    <InputText id="confirm-new-password" type="password" @bind-Value="form.ConfirmNewPassword"
                               autocomplete="new-password" aria-required="true"
                               aria-describedby="confirm-new-password-error" disabled="@isSubmitting" />
                </label>
                <div id="confirm-new-password-error" aria-live="polite">
                    <ValidationMessage For="() => form.ConfirmNewPassword" />
                </div>
            </div>
        </div>
        @if (errors.Count > 0)
        {
            <div class="profile-save-message is-error" role="alert">
                <ul>
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <div class="cv-form-actions">
            <button class="profile-btn profile-btn-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Changing password..." : "Change password")
            </button>
        </div>
    </EditForm>
</section>

@code {
    private ChangePasswordForm form = new();
    private IReadOnlyList<string> errors = [];
    private bool isSubmitting;

    private async Task SubmitAsync()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        errors = [];
        try
        {
            ServiceResult result;
            try
            {
                result = await CircuitDbGate.RunAsync(async () =>
                {
                    var state = await AuthStateProvider.GetAuthenticationStateAsync();
                    var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
                    if (state.User.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(userId))
                        return ServiceResult.Fail(ServiceErrorType.Unauthorized, "Please sign in to change your password.");

                    return await AccountService.ChangePasswordAsync(userId, new ChangePasswordRequest
                    {
                        CurrentPassword = form.CurrentPassword,
                        NewPassword = form.NewPassword
                    });
                });
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Password change failed.");
                errors = ["We could not change your password right now. Please try again."];
                return;
            }

            if (!result.Success)
            {
                errors = result.Errors;
                return;
            }

            // Drop both the password values and the previous EditContext before signing out.
            form = new ChangePasswordForm();
            StateHasChanged();
            try
            {
                // Only cookie cleanup uses the browser API; password changes call the service directly.
                var logout = await JS.InvokeAsync<AuthApiResult>("hotjobAuth.logout");
                if (!logout.Ok && logout.Status != 401)
                    Logger.LogWarning("Password changed, but refresh cookie cleanup returned {Status}.", logout.Status);
            }
            catch (Exception exception) when (exception is JSException or InvalidOperationException or OperationCanceledException)
            {
                // The service already revoked every refresh token. Cookie cleanup is best-effort.
                Logger.LogWarning(exception, "Password changed, but refresh cookie cleanup failed.");
            }
            finally
            {
                AuthStateProvider.SignOut();
                NavigationManager.NavigateTo("/login?passwordChanged=1", forceLoad: true);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
