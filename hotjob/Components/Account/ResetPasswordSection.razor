@using hotjob.Services.Account.PasswordRecovery
@using hotjob.Services.Common
@implements IDisposable
@inject IPasswordResetService Recovery
@inject CircuitDbGate CircuitDbGate
@inject HotJobAuthStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<ResetPasswordSection> Logger

@if (invalidLink)
{
    <div class="form-message error" role="alert">@PasswordResetService.InvalidLink</div>
    <p class="login-prompt"><a href="/forgot-password">Request a new reset link</a></p>
}
else
{
    <EditForm Model="form" OnValidSubmit="SubmitAsync" @key="form" class="login-form"
              aria-busy="@(isSubmitting ? "true" : "false")">
        <DataAnnotationsValidator />
        <div class="field-group">
            <label for="reset-new-password">New password (required)</label>
            <InputText id="reset-new-password" type="password" @bind-Value="form.NewPassword" autocomplete="new-password"
                       aria-required="true" aria-describedby="reset-password-error" disabled="@isSubmitting" />
            <div id="reset-password-error" aria-live="polite"><ValidationMessage For="() => form.NewPassword" /></div>
        </div>
        <div class="field-group">
            <label for="reset-confirm-password">Confirm new password (required)</label>
            <InputText id="reset-confirm-password" type="password" @bind-Value="form.ConfirmPassword" autocomplete="new-password"
                       aria-required="true" aria-describedby="reset-confirm-error" disabled="@isSubmitting" />
            <div id="reset-confirm-error" aria-live="polite"><ValidationMessage For="() => form.ConfirmPassword" /></div>
        </div>
        @if (errors.Count > 0)
        {
            <div class="form-message error" role="alert">
                <ul>@foreach (var error in errors) { <li>@error</li> }</ul>
            </div>
        }
        <button class="submit-button" type="submit" disabled="@isSubmitting">
            @(isSubmitting ? "Resetting password..." : "Reset password")
        </button>
    </EditForm>
}
<p class="login-prompt"><a href="/login">Back to sign in</a></p>

@code {
    [Parameter] public string? Email { get; set; }
    [Parameter] public string? Token { get; set; }
    private ResetPasswordForm form = new();
    private IReadOnlyList<string> errors = [];
    private bool invalidLink;
    private bool isSubmitting;
    private bool initialized;
    private string? previousEmail;
    private string? previousToken;
    private int version;

    protected override void OnParametersSet()
    {
        if (initialized && Email == previousEmail && Token == previousToken) return;
        initialized = true;
        previousEmail = Email;
        previousToken = Token;
        version++;
        form = new ResetPasswordForm();
        errors = [];
        isSubmitting = false;
        invalidLink = string.IsNullOrWhiteSpace(Email) || Email.Length > 254 ||
            string.IsNullOrWhiteSpace(Token) || Token.Length > 4096;
    }

    private async Task SubmitAsync()
    {
        if (isSubmitting || invalidLink) return;
        var submissionVersion = version;
        var submittedForm = form;
        var email = Email;
        var token = Token;
        isSubmitting = true;
        errors = [];
        try
        {
            var result = await CircuitDbGate.RunAsync(() => submissionVersion == version
                ? Recovery.ResetPasswordAsync(email, token, submittedForm.NewPassword)
                : Task.FromResult(ServiceResult.Fail(ServiceErrorType.Validation, PasswordResetService.InvalidLink)));
            if (submissionVersion != version) return;
            if (!result.Success)
            {
                invalidLink = result.Errors.Contains(PasswordResetService.InvalidLink);
                errors = invalidLink ? [] : result.Errors;
                return;
            }

            form = new ResetPasswordForm();
            submittedForm.NewPassword = "";
            submittedForm.ConfirmPassword = "";
            StateHasChanged();
            try
            {
                var cleanup = await JS.InvokeAsync<AuthApiResult>("hotjobAuth.logout");
                if (!cleanup.Ok && cleanup.Status != 401)
                    Logger.LogWarning("Password reset cookie cleanup returned {Status}.", cleanup.Status);
            }
            catch (Exception exception)
            {
                Logger.LogWarning("Password reset cookie cleanup failed ({FailureType}).", exception.GetType().Name);
            }
            finally
            {
                AuthStateProvider.SignOut();
                NavigationManager.NavigateTo("/login?passwordReset=1", forceLoad: true);
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Password reset form failed ({FailureType}).", exception.GetType().Name);
            if (submissionVersion == version) errors = [PasswordResetService.TemporaryFailure];
        }
        finally
        {
            if (submissionVersion == version) isSubmitting = false;
        }
    }

    public void Dispose()
    {
        version++;
        form.NewPassword = "";
        form.ConfirmPassword = "";
    }
}
