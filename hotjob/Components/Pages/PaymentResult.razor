@page "/payment/result"
@using System.Globalization

<PageTitle>Payment result - HotJob</PageTitle>

<section class="state-page" aria-labelledby="payment-result-title">
    @if (IsSuccess)
    {
        <p class="workspace-badge is-success">Payment successful</p>
        <h1 id="payment-result-title">Thank you — your purchase is active.</h1>
        <p class="state-lede">Your entitlement has been applied to your account.</p>
    }
    else if (IsProcessed)
    {
        <p class="workspace-badge is-warning">Payment processed</p>
        <h1 id="payment-result-title">This payment was already handled.</h1>
        <p class="state-lede">No additional charge or entitlement was applied.</p>
    }
    else
    {
        <p class="workspace-badge is-danger">Payment not completed</p>
        <h1 id="payment-result-title">We could not confirm this payment.</h1>
        <p class="state-lede">No entitlement was granted. You can try again from the billing page.</p>
    }

    @if (Amount is { } amount)
    {
        <p><strong>@amount.ToString("N0", CultureInfo.InvariantCulture) VND</strong>@(Purpose is null ? string.Empty : $" · {Purpose}")</p>
    }

    @if (!string.IsNullOrWhiteSpace(TxnRef))
    {
        <div class="state-details">
            <p>Transaction reference: <code>@TxnRef</code></p>
        </div>
    }

    <div class="state-actions">
        <a class="state-btn state-btn-primary" href="/employer/billing">Back to billing</a>
        <a class="state-btn state-btn-secondary" href="/it-jobs">Browse jobs</a>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "purpose")]
    private string? Purpose { get; set; }

    [SupplyParameterFromQuery(Name = "amount")]
    private decimal? Amount { get; set; }

    [SupplyParameterFromQuery(Name = "txnRef")]
    private string? TxnRef { get; set; }

    private bool IsSuccess => string.Equals(Status, "success", StringComparison.OrdinalIgnoreCase);

    private bool IsProcessed => string.Equals(Status, "processed", StringComparison.OrdinalIgnoreCase);
}
