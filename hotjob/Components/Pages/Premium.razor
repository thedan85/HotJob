@page "/premium"
@implements IDisposable
@rendermode InteractiveServer
@using System.Security.Claims
@using hotjob.Models.Billing
@using hotjob.Services.Billing
@using Microsoft.AspNetCore.Components.Authorization
@inject ICandidatePremiumService PremiumService
@inject IBillingService BillingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthSession AuthSession
@inject NavigationManager Navigation

<PageTitle>Candidate Premium | HotJob</PageTitle>

<AuthorizeView Roles="Candidate">
    <Authorized>
        <div class="premium-page">
            <section class="premium-hero" aria-labelledby="premium-title">
                <p class="premium-eyebrow">
                    <svg class="premium-eyebrow-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.6l2.8 5.8 6.4 .9-4.6 4.5 1.1 6.4L12 17.2l-5.7 3 1.1-6.4L2.8 9.3l6.4-.9L12 2.6z" />
                    </svg>
                    Premium
                </p>
                <h1 id="premium-title">Candidate <span class="premium-title-accent">Premium</span> plan</h1>
                <p class="premium-lede">
                    Advanced match scoring, a premium profile badge and a profile boost —
                    30 days for 99.000đ, paid by VNPay sandbox.
                </p>
                <ul class="premium-hero-meta" aria-label="Plan summary">
                    <li><span>Term</span><strong>30 days</strong></li>
                    <li><span>Price</span><strong>99.000đ</strong></li>
                    <li><span>Payment</span><strong>VNPay sandbox</strong></li>
                </ul>
            </section>

            @if (isLoading)
            {
                <section class="workspace-card" aria-busy="true" aria-label="Loading your premium status">
                    <div class="workspace-skeleton" style="height:120px"></div>
                    <p class="visually-hidden" role="status">Loading your Premium status…</p>
                </section>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="workspace-alert" role="alert">@loadError</div>
            }
            else if (status is not null)
            {
                <section class="workspace-card premium-status-card" aria-label="Your Premium status">
                    <div class="premium-status-head">
                        <div>
                            <p class="workspace-eyebrow">Your subscription</p>
                            <h2>@(status.IsPremium ? "Active" : "Not subscribed")</h2>
                            @if (status.IsPremium && status.PremiumUntil is { } until)
                            {
                                <p class="workspace-sub">Active until @until.ToString("dd MMM yyyy"). Boost active until @(status.BoostUntil?.ToString("dd MMM yyyy") ?? "—").</p>
                            }
                            else if (!status.IsPremium)
                            {
                                <p class="workspace-sub">Subscribe to Premium for advanced match scoring, a profile badge and a profile boost.</p>
                            }
                        </div>
                    </div>

                    <div class="premium-status-actions">
                        @if (status.IsPremium)
                        {
                            <button class="workspace-btn workspace-btn-primary" type="button"
                                    disabled="@isBuying"
                                    @onclick="BuyAsync">
                                @(isBuying ? "Renewing…" : "Renew Premium")
                            </button>
                        }
                        else
                        {
                            <button class="workspace-btn workspace-btn-primary" type="button"
                                    disabled="@isBuying"
                                    @onclick="BuyAsync">
                                @(isBuying ? "Subscribing…" : "Subscribe to Premium — 99.000đ")
                            </button>
                        }
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(actionError))
                {
                    <div class="workspace-alert" role="alert" aria-live="assertive">@actionError</div>
                }
            }

            <section class="workspace-card premium-plan-card" aria-label="Premium Monthly plan">
                <div class="workspace-section-head">
                    <div>
                        <h2>Premium Monthly</h2>
                        <p class="workspace-sub">99.000đ per 30 days. Your benefits run until the end of the period you paid for.</p>
                    </div>
                </div>
                <ul class="premium-plan-features">
                    <li><span><strong>Advanced match scoring:</strong> see how your CV scores against a job before you apply.</span></li>
                    <li><span><strong>Premium badge:</strong> a verified badge on your profile so employers spot you at a glance.</span></li>
                    <li><span><strong>Profile boost:</strong> your profile is shown to employers first while boosted.</span></li>
                </ul>
                <div class="premium-plain-price">
                    <strong>99.000đ</strong> <span>/ 30 days</span>
                    <p class="workspace-hint">Paid by VNPay sandbox. Your entitlement is active as soon as the gateway confirms the payment.</p>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(actionMessage))
            {
                <div class="workspace-notice" role="status" aria-live="polite">@actionMessage</div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="premium-page">
            <section class="premium-hero premium-hero-guest" aria-labelledby="premium-title">
                <p class="premium-eyebrow">
                    <svg class="premium-eyebrow-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2.6l2.8 5.8 6.4 .9-4.6 4.5 1.1 6.4L12 17.2l-5.7 3 1.1-6.4L2.8 9.3l6.4-.9L12 2.6z" />
                    </svg>
                    Premium
                </p>
                <h1 id="premium-title">Candidate <span class="premium-title-accent">Premium</span> plan</h1>
                <p class="premium-lede">
                    Please <a href="/login">sign in</a> with a candidate account to view the Premium plan.
                </p>
            </section>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private CandidatePremiumStatus? status;
    private bool isLoading = true;
    private bool hasLoadedOnce;
    private bool isBuying;
    private string? loadError;
    private string? actionMessage;
    private string? actionError;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        if (AuthSession.IsAuthenticated)
        {
            await LoadAsync();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

    private async Task<string> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub") ?? string.Empty;
    }

    private async Task LoadAsync()
    {
        if (isLoading && hasLoadedOnce)
        {
            return;
        }

        isLoading = true;
        hasLoadedOnce = true;
        loadError = null;
        try
        {
            var userId = await GetUserIdAsync();
            status = await PremiumService.GetStatusAsync(userId);
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task BuyAsync()
    {
        actionMessage = null;
        actionError = null;
        isBuying = true;
        try
        {
            var result = await BillingService.CreateCandidatePremiumCheckoutAsync(
                await GetUserIdAsync(), Plan.PremiumMonthlyCode, "127.0.0.1");
            if (!result.Success || result.Data is null)
            {
                actionError = result.Errors.FirstOrDefault() ?? "Could not start the payment.";
                return;
            }

            // forceLoad: leave the Blazor circuit and go to the gateway.
            Navigation.NavigateTo(result.Data.PaymentUrl, forceLoad: true);
        }
        catch (Exception exception)
        {
            actionError = exception.Message;
        }
        finally
        {
            isBuying = false;
        }
    }
}
