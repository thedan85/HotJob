@page "/profile"
@implements IDisposable
@rendermode InteractiveServer
@using System.Security.Claims
@using hotjob.DTOs.Authentication
@using hotjob.DTOs.Candidate
@using hotjob.Models.Users
@using hotjob.Services.Account
@using hotjob.Services.Authentication
@using hotjob.Services.Candidate
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HotJobAuthStateProvider AuthStateProvider
@inject AuthSession AuthSession
@inject IAccountService AccountService
@inject IResumeService ResumeService

<PageTitle>Your profile | HotJob</PageTitle>

@if (isLoading)
{
    <div class="profile-loading" role="status">Loading your profile...</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="profile-alert" role="alert">@errorMessage</div>
}
else
{
    <section class="profile-page-header">
        <div class="profile-header-copy">
            <p class="profile-eyebrow">Candidate workspace</p>
            <h1>Your profile</h1>
            <p>Keep your details current so employers see the right experience, and choose the CV we share with them.</p>
        </div>
        <div class="profile-header-actions">
            <a class="profile-btn profile-btn-secondary" href="/my-applications">My applications</a>
            <button class="profile-btn profile-btn-primary" type="button" @onclick="SaveProfileAsync" disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save changes")
            </button>
        </div>
    </section>

    <div class="profile-layout">
        <aside class="profile-sidebar">
            <div class="profile-card">
                <div class="profile-summary">
                    <div class="profile-avatar-large">@Initials</div>
                    <button class="profile-avatar-edit" type="button" title="Change photo" aria-label="Change photo">+</button>
                    <h2>@DisplayName</h2>
                    <p>@(string.IsNullOrWhiteSpace(profileForm.Position) ? "Candidate" : profileForm.Position)</p>
                    <span class="profile-status @(string.IsNullOrWhiteSpace(profileForm.JobSeekingStatus) ? "profile-status-empty" : string.Empty)"><span></span> @(string.IsNullOrWhiteSpace(profileForm.JobSeekingStatus) ? "Add your job seeking status" : profileForm.JobSeekingStatus)</span>
                </div>
                <nav class="profile-nav" aria-label="Profile sections">
                    <a class="active" href="#personal-info">Personal details</a>
                    <a href="#cv-management">Manage CVs <span>(@resumes.Count)</span></a>
                    <a href="#preferences">Career preferences</a>
                </nav>
            </div>
        </aside>

        <main class="profile-content">
            <section id="personal-info" class="profile-box">
                <div class="profile-box-heading">
                    <div><h2>Personal details</h2><p>Keep your profile up to date so employers can find you.</p></div>
                </div>
                <EditForm Model="profileForm" OnValidSubmit="SaveProfileAsync">
                    <DataAnnotationsValidator />
                    <div class="profile-form-grid">
                        <label>Full name <InputText @bind-Value="profileForm.FullName" /></label>
                        <label>Email <InputText @bind-Value="profileForm.Email" type="email" /></label>
                        <label>Location <InputText @bind-Value="profileForm.Address" placeholder="City, country" /></label>
                        <label>Position <InputText @bind-Value="profileForm.Position" placeholder="e.g. Senior Marketing Specialist" /></label>
                        <label class="profile-field-wide">LinkedIn URL <InputText @bind-Value="profileForm.LinkedInUrl" placeholder="https://linkedin.com/in/your-name" /></label>
                        <label class="profile-field-wide">About you <InputTextArea @bind-Value="profileForm.Summary" placeholder="Tell employers what you do best" /></label>
                    </div>
                </EditForm>
                @if (!string.IsNullOrWhiteSpace(saveMessage))
                {
                    <p class="profile-save-message @(saveIsError ? "is-error" : string.Empty)" role="@(saveIsError ? "alert" : "status")">@saveMessage</p>
                }
            </section>

            <section id="cv-management" class="profile-box">
                <div class="profile-box-heading">
                    <div><h2>CV &amp; resume management</h2><p>Create a resume per role you target. Your primary CV is preselected when you apply.</p></div>
                    <span class="profile-badge">@resumes.Count / 5 resumes</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(resumeMessage))
                {
                    <p class="profile-save-message" role="status">@resumeMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(resumeError))
                {
                    <div class="profile-resume-alert" role="alert">@resumeError</div>
                }

                @if (showCreateChoice)
                {
                    <div class="cv-create-choice" role="group" aria-label="Create a new CV">
                        <div class="cv-create-option">
                            <h3>Upload CV</h3>
                            <p>Already have a CV? Upload the file and add at least one skill.</p>
                            <button class="profile-btn profile-btn-primary profile-btn-small" type="button" @onclick="StartUploadResume">
                                Upload CV
                            </button>
                        </div>
                        <div class="cv-create-option">
                            <h3>Build CV</h3>
                            <p>No file? Enter your details and add at least one skill.</p>
                            <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="StartCreateResume">
                                Build CV
                            </button>
                        </div>
                        <button class="cv-remove cv-choice-close" type="button" aria-label="Close create CV options" @onclick="CancelCreate">×</button>
                    </div>
                }

                @if (showUploadForm)
                {
                    <div class="cv-form">
                        <div class="cv-form-heading">
                            <h3>Upload a new CV</h3>
                            <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="CancelCreate">Cancel</button>
                        </div>
                        <EditForm Model="uploadForm" OnValidSubmit="CreateFromUploadAsync">
                            <DataAnnotationsValidator />
                            <div class="profile-form-grid">
                                <label>
                                    CV title (required)
                                    <InputText @bind-Value="uploadForm.Title" placeholder="e.g. Backend Engineer CV" />
                                    <ValidationMessage For="() => uploadForm.Title" />
                                </label>
                                <label class="profile-field-wide">
                                    CV file (required)
                                    <InputFile OnChange="OnUploadFileSelected" accept=".pdf,.doc,.docx" />
                                    @if (uploadFile is not null)
                                    {
                                        <span class="cv-form-hint">@uploadFile.Name · @FormatBytes(uploadFile.Size)</span>
                                    }
                                </label>
                            </div>
                            <fieldset class="cv-fieldset">
                                <legend>Skills</legend>
                                @if (uploadForm.Skills.Count == 0)
                                {
                                    <p class="cv-form-hint">At least one skill is required. Add the skills this resume should match against jobs.</p>
                                }
                                else
                                {
                                    @for (var index = 0; index < uploadForm.Skills.Count; index++)
                                    {
                                        var row = index;
                                        <div class="cv-skill-row" @key="row">
                                            <span class="profile-badge">@SkillName(uploadForm.Skills[row].SkillId)</span>
                                            <label class="cv-years">Years <InputNumber @bind-Value="uploadForm.Skills[row].YearsOfExperience" min="0" max="50" /></label>
                                            <button class="cv-remove" type="button" aria-label="Remove skill" @onclick="() => RemoveUploadSkill(row)">×</button>
                                        </div>
                                    }
                                }
                                <div class="cv-skill-picker">
                                    <label>
                                        Skill
                                        <select @bind="uploadSkillPickerId">
                                            <option value="0">Choose a skill</option>
                                            @foreach (var skill in AvailableUploadSkills)
                                            {
                                                <option value="@skill.Id">@skill.Name</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        Years
                                        <input type="number" min="0" max="50" @bind="uploadSkillPickerYears" />
                                    </label>
                                    <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="AddUploadSkill">Add skill</button>
                                </div>
                            </fieldset>
                            <p class="cv-form-hint">PDF, DOC or DOCX only. Maximum 5 MB.</p>
                            <div class="cv-form-actions">
                                <button class="profile-btn profile-btn-primary" type="submit" disabled="@isUploadingCv">
                                    @(isUploadingCv ? "Uploading..." : "Create CV")
                                </button>
                            </div>
                        </EditForm>
                    </div>
                }

                @if (resumes.Count == 0)
                {
                    <div class="profile-upload">
                        <div class="profile-upload-icon" aria-hidden="true">↑</div>
                        <h3>Create your first resume</h3>
                        <p>Upload an existing CV, or build one with your experience and skills.</p>
                        <button class="profile-btn profile-btn-primary profile-btn-small" type="button" @onclick="OpenCreateChoice" disabled="@(showResumeForm || showUploadForm)">
                            Create a new CV
                        </button>
                    </div>
                }
                else
                {
                    <div class="cv-toolbar">
                        <p>Upload a file from each resume card. New uploads replace the previous file for that resume.</p>
                        <button class="profile-btn profile-btn-primary profile-btn-small" type="button" @onclick="OpenCreateChoice"
                                disabled="@(showResumeForm || showUploadForm || resumes.Count >= 5)">
                            Add CV
                        </button>
                    </div>
                    <div class="cv-list">
                        @foreach (var resume in resumes)
                        {
                            <div class="cv-item @(resume.IsPrimary ? "cv-item-default" : string.Empty)">
                                <div class="cv-file">
                                    <span class="cv-type">@ResumeFileType(resume.FileUrl)</span>
                                    <div class="cv-file-copy">
                                        <h3>
                                            @resume.Title
                                            @if (resume.IsPrimary)
                                            {
                                                <span class="profile-badge profile-badge-green">Primary CV</span>
                                            }
                                        </h3>
                                        <p>
                                            Updated @resume.CreatedAt.ToString("dd MMM yyyy")
                                            · @(resume.FileUrl is null ? "No file attached" : "File attached")
                                            · @resume.SkillCount skill@(resume.SkillCount == 1 ? string.Empty : "s")
                                        </p>
                                    </div>
                                </div>
                                <div class="cv-actions">
                                    @if (!resume.IsPrimary)
                                    {
                                        <button class="profile-btn profile-btn-secondary profile-btn-small" type="button"
                                                disabled="@(primaryUpdatingId is not null)"
                                                @onclick="() => SetPrimaryAsync(resume.Id)">
                                            @(primaryUpdatingId == resume.Id ? "Saving..." : "Set as primary")
                                        </button>
                                    }
                                    <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="() => EditResumeAsync(resume.Id)">
                                        Edit
                                    </button>
                                    <label class="cv-icon-button cv-upload" title="Upload CV file">
                                        <span aria-hidden="true">@(uploadingResumeId == resume.Id ? "…" : "↑")</span>
                                        <span class="visually-hidden">Upload a CV file for @resume.Title</span>
                                        <InputFile OnChange="args => UploadAsync(resume.Id, args)" accept=".pdf,.doc,.docx"
                                                   class="cv-file-input" disabled="@(uploadingResumeId is not null)" />
                                    </label>
                                    @if (resume.FileUrl is not null)
                                    {
                                        <a class="cv-icon-button" href="@resume.FileUrl" target="_blank" rel="noopener noreferrer" title="Open @resume.Title" download>↓</a>
                                    }
                                    @if (pendingDeleteId != resume.Id)
                                    {
                                        <button class="cv-icon-button cv-delete" type="button" title="Delete @resume.Title" @onclick="() => { pendingDeleteId = resume.Id; }">×</button>
                                    }
                                </div>
                                @if (pendingDeleteId == resume.Id)
                                {
                                    <div class="cv-confirm" role="group" aria-label="Confirm deleting @resume.Title">
                                        <span>Delete this resume? This cannot be undone.</span>
                                        <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="() => { pendingDeleteId = null; }">Cancel</button>
                                        <button class="profile-btn profile-btn-primary profile-btn-small cv-confirm-danger" type="button" @onclick="() => DeleteResumeAsync(resume.Id)">Confirm delete</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (showResumeForm)
                {
                    <div class="cv-form">
                        <div class="cv-form-heading">
                            <h3>@(editingResumeId is null ? "New resume" : "Edit resume")</h3>
                            <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="CancelResumeForm">Cancel</button>
                        </div>
                        <EditForm Model="resumeForm" OnValidSubmit="SaveResumeAsync">
                            <DataAnnotationsValidator />
                            <div class="profile-form-grid">
                                <label>
                                    Resume title (required)
                                    <InputText @bind-Value="resumeForm.Title" placeholder="e.g. Backend Engineer CV" />
                                    <ValidationMessage For="() => resumeForm.Title" />
                                </label>
                                <label class="profile-field-wide">Professional summary <InputTextArea @bind-Value="resumeForm.Summary" placeholder="A short pitch for this resume" /></label>
                            </div>

                            <fieldset class="cv-fieldset">
                                <legend>Education</legend>
                                @for (var index = 0; index < resumeForm.Educations.Count; index++)
                                {
                                    var row = index;
                                    <div class="cv-form-row" @key="row">
                                        <label>School <InputText @bind-Value="resumeForm.Educations[row].SchoolName" placeholder="School name" /></label>
                                        <label>Major <InputText @bind-Value="resumeForm.Educations[row].Major" placeholder="Major" /></label>
                                        <label>Start <InputDate @bind-Value="resumeForm.Educations[row].StartDate" /></label>
                                        <label>End <InputDate @bind-Value="resumeForm.Educations[row].EndDate" /></label>
                                        <label>GPA <InputNumber @bind-Value="resumeForm.Educations[row].Gpa" step="0.1" min="0" max="4" /></label>
                                        <button class="cv-remove" type="button" aria-label="Remove education entry" @onclick="() => RemoveEducation(row)">×</button>
                                    </div>
                                }
                                <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="AddEducation">+ Add education</button>
                            </fieldset>

                            <fieldset class="cv-fieldset">
                                <legend>Work experience</legend>
                                @for (var index = 0; index < resumeForm.WorkExperiences.Count; index++)
                                {
                                    var row = index;
                                    <div class="cv-form-row" @key="row">
                                        <label>Company <InputText @bind-Value="resumeForm.WorkExperiences[row].CompanyName" placeholder="Company name" /></label>
                                        <label>Job title <InputText @bind-Value="resumeForm.WorkExperiences[row].JobTitle" placeholder="Job title" /></label>
                                        <label>Start <InputDate @bind-Value="resumeForm.WorkExperiences[row].StartDate" /></label>
                                        <label>End <InputDate @bind-Value="resumeForm.WorkExperiences[row].EndDate" /></label>
                                        <button class="cv-remove" type="button" aria-label="Remove work experience entry" @onclick="() => RemoveWorkExperience(row)">×</button>
                                    </div>
                                }
                                <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="AddWorkExperience">+ Add experience</button>
                            </fieldset>

                            <fieldset class="cv-fieldset">
                                <legend>Skills</legend>
                                @if (resumeForm.Skills.Count == 0)
                                {
                                    <p class="cv-form-hint">At least one skill is required. Add the skills this resume should match against jobs.</p>
                                }
                                else
                                {
                                    @for (var index = 0; index < resumeForm.Skills.Count; index++)
                                    {
                                        var row = index;
                                        <div class="cv-skill-row" @key="row">
                                            <span class="profile-badge">@SkillName(resumeForm.Skills[row].SkillId)</span>
                                            <label class="cv-years">Years <InputNumber @bind-Value="resumeForm.Skills[row].YearsOfExperience" min="0" max="50" /></label>
                                            <button class="cv-remove" type="button" aria-label="Remove skill" @onclick="() => RemoveSkill(row)">×</button>
                                        </div>
                                    }
                                }
                                <div class="cv-skill-picker">
                                    <label>
                                        Skill
                                        <select @bind="skillPickerId">
                                            <option value="0">Choose a skill</option>
                                            @foreach (var skill in AvailableSkills)
                                            {
                                                <option value="@skill.Id">@skill.Name</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        Years
                                        <input type="number" min="0" max="50" @bind="skillPickerYears" />
                                    </label>
                                    <button class="profile-btn profile-btn-secondary profile-btn-small" type="button" @onclick="AddSkill">Add skill</button>
                                </div>
                            </fieldset>

                            <div class="cv-form-actions">
                                <button class="profile-btn profile-btn-primary" type="submit" disabled="@isSavingResume">
                                    @(isSavingResume ? "Saving..." : editingResumeId is null ? "Create resume" : "Save resume")
                                </button>
                            </div>
                        </EditForm>
                    </div>
                }
            </section>

            <section id="preferences" class="profile-box">
                <div class="profile-box-heading"><div><h2>Career preferences</h2><p>Help us show you more relevant opportunities.</p></div></div>
                <EditForm Model="profileForm" OnValidSubmit="SaveProfileAsync">
                    <DataAnnotationsValidator />
                    <div class="preference-grid">
                        <label>Job seeking status <InputText @bind-Value="profileForm.JobSeekingStatus" placeholder="e.g. Actively looking" /></label>
                        <label>Preferred work model <InputText @bind-Value="profileForm.PreferredWorkModel" placeholder="e.g. Hybrid / Remote" /></label>
                        <label>Preferred location <InputText @bind-Value="profileForm.PreferredLocation" placeholder="e.g. Ho Chi Minh City" /></label>
                    </div>
                </EditForm>
            </section>
        </main>
    </div>
}

@code {
    private const long MaxCvBytes = 5 * 1024 * 1024;

    private bool isLoading = true;
    private bool hasLoadedOnce;
    private bool isSaving;
    private bool saveIsError;
    private string? errorMessage;
    private string? saveMessage;
    private string? cvError;
    private ProfileForm profileForm = new();

    private List<ResumeListItemDto> resumes = new();
    private List<SkillOptionDto> skillOptions = new();
    private ResumeInput resumeForm = new();
    private int? editingResumeId;
    private bool showResumeForm;
    private bool showCreateChoice;
    private bool showUploadForm;
    private ResumeInput uploadForm = new();
    private IBrowserFile? uploadFile;
    private bool isUploadingCv;
    private bool isSavingResume;
    private string? resumeMessage;
    private string? resumeError;
    private int? pendingDeleteId;
    private int? uploadingResumeId;
    private int? primaryUpdatingId;
    private int skillPickerId;
    private int skillPickerYears;
    private int uploadSkillPickerId;
    private int uploadSkillPickerYears;

    private string DisplayName => string.IsNullOrWhiteSpace(profileForm.FullName) ? "Your profile" : profileForm.FullName;
    private string Initials => string.Join("", DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();

    private IEnumerable<SkillOptionDto> AvailableSkills =>
        skillOptions.Where(option => resumeForm.Skills.All(skill => skill.SkillId != option.Id));

    private IEnumerable<SkillOptionDto> AvailableUploadSkills =>
        skillOptions.Where(option => uploadForm.Skills.All(skill => skill.SkillId != option.Id));

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        if (AuthSession.IsAuthenticated)
        {
            await LoadAsync();
        }
        else
        {
            isLoading = false;
            errorMessage = "Please sign in to view your profile.";
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

    private async Task<string> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub") ?? string.Empty;
    }

    private async Task LoadAsync()
    {
        if (isLoading && hasLoadedOnce)
        {
            return;
        }
        isLoading = true;
        hasLoadedOnce = true;
        errorMessage = null;
        cvError = null;
        try
        {
            var userId = await GetUserIdAsync();
            if (string.IsNullOrWhiteSpace(userId))
            {
                errorMessage = "Please sign in to view your profile.";
                return;
            }

            var result = await AccountService.GetProfileAsync(userId);
            if (!result.Success || result.Data?.Candidate is null)
            {
                errorMessage = result.Errors.FirstOrDefault() ?? "We could not load your candidate profile.";
                return;
            }

            var candidate = result.Data.Candidate;
            profileForm = new ProfileForm
            {
                FullName = candidate.FullName,
                Email = result.Data.Email,
                Address = candidate.Address,
                LinkedInUrl = candidate.LinkedInUrl,
                Position = candidate.Position,
                Summary = candidate.Summary,
                JobSeekingStatus = candidate.JobSeekingStatus,
                PreferredWorkModel = candidate.PreferredWorkModel,
                PreferredLocation = candidate.PreferredLocation
            };

            // Sequential awaits: ResumeService and AccountService share the circuit's DbContext.
            var resumeResult = await ResumeService.ListAsync(userId);
            if (resumeResult.Success && resumeResult.Data is not null)
            {
                resumes = resumeResult.Data.ToList();
            }
            else
            {
                cvError = resumeResult.Errors.FirstOrDefault() ?? "We could not load your resumes.";
            }

            var skillResult = await ResumeService.ListSkillsAsync();
            if (skillResult.Success && skillResult.Data is not null)
            {
                skillOptions = skillResult.Data.ToList();
            }
            else if (string.IsNullOrWhiteSpace(cvError))
            {
                cvError = skillResult.Errors.FirstOrDefault() ?? "We could not load the skill list.";
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub");
        if (string.IsNullOrWhiteSpace(userId)) return;

        isSaving = true;
        saveMessage = null;
        saveIsError = false;
        var result = await AccountService.UpdateProfileAsync(userId, new UpdateProfileRequest
        {
            FullName = profileForm.FullName,
            Email = profileForm.Email,
            Address = profileForm.Address,
            LinkedInUrl = profileForm.LinkedInUrl,
            Position = profileForm.Position,
            Summary = profileForm.Summary,
            JobSeekingStatus = profileForm.JobSeekingStatus,
            PreferredWorkModel = profileForm.PreferredWorkModel,
            PreferredLocation = profileForm.PreferredLocation
        });
        isSaving = false;
        if (result.Success && result.Data?.Candidate is not null)
        {
            AuthStateProvider.RefreshIdentity(result.Data.Candidate.FullName, result.Data.Email);
            profileForm.FullName = result.Data.Candidate.FullName;
            profileForm.Email = result.Data.Email;
            profileForm.Address = result.Data.Candidate.Address;
            profileForm.LinkedInUrl = result.Data.Candidate.LinkedInUrl;
            profileForm.Position = result.Data.Candidate.Position;
            profileForm.Summary = result.Data.Candidate.Summary;
            profileForm.JobSeekingStatus = result.Data.Candidate.JobSeekingStatus;
            profileForm.PreferredWorkModel = result.Data.Candidate.PreferredWorkModel;
            profileForm.PreferredLocation = result.Data.Candidate.PreferredLocation;
        }
        saveMessage = result.Success ? "Profile changes saved successfully." : result.Errors.FirstOrDefault() ?? "Unable to save your changes.";
        saveIsError = !result.Success;
    }

    private void OpenCreateChoice()
    {
        showResumeForm = false;
        showUploadForm = false;
        showCreateChoice = true;
        uploadForm = new ResumeInput();
        uploadFile = null;
        uploadSkillPickerId = 0;
        uploadSkillPickerYears = 0;
        resumeError = null;
        resumeMessage = null;
    }

    private void StartUploadResume()
    {
        showCreateChoice = false;
        showUploadForm = true;
        uploadForm = new ResumeInput();
        uploadFile = null;
        uploadSkillPickerId = 0;
        uploadSkillPickerYears = 0;
        resumeError = null;
        resumeMessage = null;
    }

    private void CancelCreate()
    {
        showCreateChoice = false;
        showUploadForm = false;
        uploadForm = new ResumeInput();
        uploadFile = null;
        uploadSkillPickerId = 0;
        uploadSkillPickerYears = 0;
        resumeError = null;
    }

    private void OnUploadFileSelected(InputFileChangeEventArgs args)
    {
        resumeError = null;
        uploadFile = null;
        var file = args.File;
        if (file.Size <= 0)
        {
            resumeError = "The selected file is empty.";
            return;
        }
        if (file.Size > MaxCvBytes)
        {
            resumeError = "CV files must be 5 MB or smaller.";
            return;
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".pdf" or ".doc" or ".docx"))
        {
            resumeError = "Only PDF, DOC and DOCX files are supported.";
            return;
        }

        uploadFile = file;
    }

    private async Task CreateFromUploadAsync()
    {
        if (isUploadingCv) return;

        resumeError = null;
        resumeMessage = null;
        if (uploadFile is null)
        {
            resumeError = "Choose a CV file to upload.";
            return;
        }
        if (uploadForm.Skills.Count == 0)
        {
            resumeError = "Add at least one skill before creating a CV.";
            return;
        }
        if (resumes.Count >= 5)
        {
            resumeError = "You can keep up to 5 resumes. Delete one before adding another.";
            return;
        }

        isUploadingCv = true;
        try
        {
            var userId = await GetUserIdAsync();
            var created = await ResumeService.CreateAsync(userId, uploadForm);
            if (!created.Success || created.Data is null)
            {
                resumeError = string.Join(" ", created.Errors);
                return;
            }

            var resumeId = created.Data.Id;
            try
            {
                await using var stream = uploadFile.OpenReadStream(MaxCvBytes);
                var uploaded = await ResumeService.UploadFileAsync(
                    userId, resumeId, uploadFile.Name, uploadFile.Size, stream);
                if (!uploaded.Success)
                {
                    await ResumeService.DeleteAsync(userId, resumeId);
                    resumeError = uploaded.Errors.FirstOrDefault() ?? "We could not upload this file.";
                    return;
                }

                resumeMessage = "CV uploaded.";
            }
            catch
            {
                await ResumeService.DeleteAsync(userId, resumeId);
                throw;
            }

            showCreateChoice = false;
            showUploadForm = false;
            uploadForm = new ResumeInput();
            uploadFile = null;
            uploadSkillPickerId = 0;
            uploadSkillPickerYears = 0;
            await ReloadResumesAsync();
        }
        catch (IOException)
        {
            resumeError = "CV files must be 5 MB or smaller.";
        }
        catch (Exception exception)
        {
            resumeError = exception.Message;
        }
        finally
        {
            isUploadingCv = false;
        }
    }

    private static string FormatBytes(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / (1024d * 1024d):0.#} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private void StartCreateResume()
    {
        showCreateChoice = false;
        showUploadForm = false;
        editingResumeId = null;
        resumeForm = new ResumeInput();
        skillPickerId = 0;
        skillPickerYears = 0;
        resumeError = null;
        resumeMessage = null;
        showResumeForm = true;
    }

    private async Task EditResumeAsync(int resumeId)
    {
        resumeError = null;
        resumeMessage = null;
        var userId = await GetUserIdAsync();
        var result = await ResumeService.GetAsync(userId, resumeId);
        if (!result.Success || result.Data is null)
        {
            resumeError = result.Errors.FirstOrDefault() ?? "We could not load this resume.";
            return;
        }

        var detail = result.Data;
        editingResumeId = detail.Id;
        resumeForm = new ResumeInput
        {
            Title = detail.Title,
            Summary = detail.Summary,
            Educations = detail.Educations.Select(entry => new ResumeEducationInput
            {
                SchoolName = entry.SchoolName,
                Major = entry.Major,
                StartDate = entry.StartDate,
                EndDate = entry.EndDate,
                Gpa = entry.Gpa,
                Description = entry.Description
            }).ToList(),
            WorkExperiences = detail.WorkExperiences.Select(entry => new ResumeWorkExperienceInput
            {
                CompanyName = entry.CompanyName,
                JobTitle = entry.JobTitle,
                StartDate = entry.StartDate,
                EndDate = entry.EndDate,
                Description = entry.Description
            }).ToList(),
            Skills = detail.Skills.Select(skill => new ResumeSkillInput
            {
                SkillId = skill.SkillId,
                YearsOfExperience = skill.YearsOfExperience
            }).ToList()
        };
        skillPickerId = 0;
        skillPickerYears = 0;
        showResumeForm = true;
    }

    private void CancelResumeForm()
    {
        showResumeForm = false;
        editingResumeId = null;
        resumeForm = new ResumeInput();
        skillPickerId = 0;
    }

    private async Task SaveResumeAsync()
    {
        if (isSavingResume) return;

        resumeError = null;
        resumeMessage = null;
        if (resumeForm.Skills.Count == 0)
        {
            resumeError = "Add at least one skill before saving a CV.";
            return;
        }

        isSavingResume = true;
        try
        {
            var userId = await GetUserIdAsync();
            var result = editingResumeId is null
                ? await ResumeService.CreateAsync(userId, resumeForm)
                : await ResumeService.UpdateAsync(userId, editingResumeId.Value, resumeForm);
            if (!result.Success || result.Data is null)
            {
                resumeError = string.Join(" ", result.Errors);
                return;
            }

            resumeMessage = editingResumeId is null ? "Resume created." : "Resume saved.";
            showResumeForm = false;
            editingResumeId = null;
            resumeForm = new ResumeInput();
            await ReloadResumesAsync();
        }
        catch (Exception exception)
        {
            resumeError = exception.Message;
        }
        finally
        {
            isSavingResume = false;
        }
    }

    private async Task UploadAsync(int resumeId, InputFileChangeEventArgs args)
    {
        resumeError = null;
        resumeMessage = null;
        var file = args.File;
        if (file.Size <= 0)
        {
            resumeError = "The selected file is empty.";
            return;
        }
        if (file.Size > MaxCvBytes)
        {
            resumeError = "CV files must be 5 MB or smaller.";
            return;
        }

        uploadingResumeId = resumeId;
        try
        {
            var userId = await GetUserIdAsync();
            await using var stream = file.OpenReadStream(MaxCvBytes);
            var result = await ResumeService.UploadFileAsync(userId, resumeId, file.Name, file.Size, stream);
            if (!result.Success)
            {
                resumeError = result.Errors.FirstOrDefault() ?? "We could not upload this file.";
                return;
            }

            resumeMessage = "CV uploaded.";
            await ReloadResumesAsync();
        }
        catch (IOException)
        {
            resumeError = "CV files must be 5 MB or smaller.";
        }
        catch (Exception exception)
        {
            resumeError = exception.Message;
        }
        finally
        {
            uploadingResumeId = null;
        }
    }

    private async Task SetPrimaryAsync(int resumeId)
    {
        resumeError = null;
        resumeMessage = null;
        primaryUpdatingId = resumeId;
        try
        {
            var userId = await GetUserIdAsync();
            var result = await ResumeService.SetPrimaryAsync(userId, resumeId);
            if (!result.Success)
            {
                resumeError = result.Errors.FirstOrDefault() ?? "We could not update your primary resume.";
                return;
            }

            resumeMessage = "Primary CV updated.";
            await ReloadResumesAsync();
        }
        finally
        {
            primaryUpdatingId = null;
        }
    }

    private async Task DeleteResumeAsync(int resumeId)
    {
        resumeError = null;
        resumeMessage = null;
        try
        {
            var userId = await GetUserIdAsync();
            var result = await ResumeService.DeleteAsync(userId, resumeId);
            pendingDeleteId = null;
            if (!result.Success)
            {
                resumeError = result.Errors.FirstOrDefault() ?? "We could not delete this resume.";
                return;
            }

            resumeMessage = "Resume deleted.";
            if (editingResumeId == resumeId)
            {
                CancelResumeForm();
            }
            await ReloadResumesAsync();
        }
        catch (Exception exception)
        {
            resumeError = exception.Message;
        }
    }

    private async Task ReloadResumesAsync()
    {
        var userId = await GetUserIdAsync();
        var result = await ResumeService.ListAsync(userId);
        if (result.Success && result.Data is not null)
        {
            resumes = result.Data.ToList();
        }
        else
        {
            resumeError = result.Errors.FirstOrDefault() ?? "We could not refresh your resumes.";
        }
    }

    private void AddEducation() => resumeForm.Educations.Add(new ResumeEducationInput());

    private void RemoveEducation(int index) => resumeForm.Educations.RemoveAt(index);

    private void AddWorkExperience() => resumeForm.WorkExperiences.Add(new ResumeWorkExperienceInput());

    private void RemoveWorkExperience(int index) => resumeForm.WorkExperiences.RemoveAt(index);

    private void AddSkill()
    {
        resumeError = null;
        resumeMessage = null;
        if (skillPickerId <= 0)
        {
            resumeError = "Choose a skill to add.";
            return;
        }
        if (resumeForm.Skills.Any(skill => skill.SkillId == skillPickerId))
        {
            resumeError = "That skill is already on this resume.";
            return;
        }
        if (skillPickerYears is < 0 or > 50)
        {
            resumeError = "Skill experience must be between 0 and 50 years.";
            return;
        }

        resumeForm.Skills.Add(new ResumeSkillInput
        {
            SkillId = skillPickerId,
            YearsOfExperience = skillPickerYears
        });
        skillPickerId = 0;
        skillPickerYears = 0;
    }

    private void RemoveSkill(int index) => resumeForm.Skills.RemoveAt(index);

    private void AddUploadSkill()
    {
        resumeError = null;
        resumeMessage = null;
        if (uploadSkillPickerId <= 0)
        {
            resumeError = "Choose a skill to add.";
            return;
        }
        if (uploadForm.Skills.Any(skill => skill.SkillId == uploadSkillPickerId))
        {
            resumeError = "That skill is already on this resume.";
            return;
        }
        if (uploadSkillPickerYears is < 0 or > 50)
        {
            resumeError = "Skill experience must be between 0 and 50 years.";
            return;
        }

        uploadForm.Skills.Add(new ResumeSkillInput
        {
            SkillId = uploadSkillPickerId,
            YearsOfExperience = uploadSkillPickerYears
        });
        uploadSkillPickerId = 0;
        uploadSkillPickerYears = 0;
    }

    private void RemoveUploadSkill(int index) => uploadForm.Skills.RemoveAt(index);

    private string SkillName(int skillId) =>
        skillOptions.FirstOrDefault(option => option.Id == skillId)?.Name ?? $"Skill #{skillId}";

    private static string ResumeFileType(string? fileUrl)
    {
        if (string.IsNullOrWhiteSpace(fileUrl)) return "CV";
        var extension = Path.GetExtension(fileUrl).TrimStart('.').ToUpperInvariant();
        return string.IsNullOrWhiteSpace(extension) ? "CV" : extension;
    }

