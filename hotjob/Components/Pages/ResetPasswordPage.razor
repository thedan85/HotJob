@page "/reset-password"
@layout MainLayout
@rendermode InteractiveServer
@using hotjob.Components.Account

<PageTitle>Reset password | HotJob</PageTitle>
<HeadContent><meta name="referrer" content="no-referrer" /></HeadContent>
<PasswordRecoveryCard Title="Choose a new password" Intro="Enter and confirm your new password to recover access to your account.">
    <ResetPasswordSection Email="@Email" Token="@Token" />
</PasswordRecoveryCard>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }
}
