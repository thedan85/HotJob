@page "/companies/{id:int}"
@using Microsoft.AspNetCore.Authorization
@using hotjob.DTOs.Company
@using hotjob.DTOs.Job
@using hotjob.Models.Users
@using hotjob.Services.Common
@using hotjob.Services.Company
@inject ICompanyService CompanyService
@attribute [AllowAnonymous]
@attribute [StreamRendering]

<PageTitle>@(company is null ? "Company" : $"{company.CompanyName} | HotJob")</PageTitle>

@if (isLoading)
{
    <p class="company-detail-status" role="status">Loading company…</p>
}
else if (loadError == "not-found" || company is null)
{
    <div class="company-detail-empty">
        <h1>Company not found</h1>
        <p>This company is not available or is not yet approved.</p>
        <a class="company-detail-back" href="/companies">← Back to companies</a>
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <p class="company-detail-status company-detail-error" role="alert">@loadError</p>
}
else
{
    <nav class="company-detail-crumb" aria-label="Breadcrumb">
        <a href="/companies">← Back to companies</a>
    </nav>

    <article class="company-detail">
        <header class="company-detail-header">
            @if (!string.IsNullOrWhiteSpace(company.LogoUrl))
            {
                <img class="company-detail-logo" src="@company.LogoUrl" alt="@company.CompanyName logo" />
            }
            else
            {
                <div class="company-detail-initials" aria-hidden="true">@Initials(company.CompanyName)</div>
            }
            <div class="company-detail-heading">
                <h1>@company.CompanyName</h1>
                @if (!string.IsNullOrWhiteSpace(company.OwnerName))
                {
                    <p class="company-detail-owner">Owner: <strong>@company.OwnerName</strong></p>
                }
            </div>
        </header>

        <section class="company-detail-overview" aria-label="Company overview">
            <h2>Overview</h2>
            <dl class="company-detail-facts">
                <div class="company-detail-fact">
                    <dt>Industry</dt>
                    <dd>@(string.IsNullOrWhiteSpace(company.Industry) ? "—" : company.Industry)</dd>
                </div>
                <div class="company-detail-fact">
                    <dt>Location</dt>
                    <dd>@(string.IsNullOrWhiteSpace(company.Location) ? "—" : company.Location)</dd>
                </div>
                <div class="company-detail-fact">
                    <dt>Company size</dt>
                    <dd>@(company.Scale.HasValue ? ScaleLabel(company.Scale.Value) : "—")</dd>
                </div>
                <div class="company-detail-fact">
                    <dt>Website</dt>
                    <dd>
                        @if (!string.IsNullOrWhiteSpace(company.Website))
                        {
                            <a href="@company.Website" target="_blank" rel="noopener noreferrer">@company.Website</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </dd>
                </div>
            </dl>
        </section>

        <section class="company-detail-about" aria-label="About this company">
            <h2>About</h2>
            @if (!string.IsNullOrWhiteSpace(company.Description))
            {
                <p class="company-detail-desc">@company.Description</p>
            }
            else
            {
                <p class="company-detail-muted">This company has not added a description yet.</p>
            }
        </section>

        <div class="company-detail-actions">
            <a class="company-detail-jobs" href="@JobsUrl">Show jobs</a>
        </div>

        <section class="company-detail-reviews" aria-label="Company reviews">
            <div class="company-detail-reviews-head">
                <h2>Reviews</h2>
                @if (reviews is { TotalCount: > 0 })
                {
                    <span class="company-detail-rating">@reviews.TotalCount review@(reviews.TotalCount == 1 ? string.Empty : "s")</span>
                }
            </div>

            @if (reviews is null)
            {
                <p class="company-detail-muted">Loading reviews…</p>
            }
            else if (reviews.Items.Count == 0)
            {
                <p class="company-detail-muted">No reviews yet.</p>
            }
            else
            {
                <ul class="review-list">
                    @foreach (var review in reviews.Items)
                    {
                        <li class="review-card">
                            <div class="review-head">
                                <span class="review-avatar" aria-hidden="true">@Initials(review.ReviewerName)</span>
                                <div>
                                    <p class="review-author">@review.ReviewerName</p>
                                    <p class="review-date">@review.CreatedAt.ToString("MMM dd, yyyy")</p>
                                </div>
                                <span class="review-stars" aria-label="@review.RatingScore out of 5">@Stars(review.RatingScore)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.ReviewText))
                            {
                                <p class="review-text">@review.ReviewText</p>
                            }
                        </li>
                    }
                </ul>

                @if (reviews.TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Review pages">
                        @if (reviews.Page > 1)
                        {
                            <a class="page-btn" href="@PageUrl(reviews.Page - 1)">‹ Prev</a>
                        }
                        else
                        {
                            <span class="page-btn disabled" aria-disabled="true">‹ Prev</span>
                        }
                        <span class="page-info">Page @reviews.Page of @reviews.TotalPages</span>
                        @if (reviews.Page < reviews.TotalPages)
                        {
                            <a class="page-btn" href="@PageUrl(reviews.Page + 1)">Next ›</a>
                        }
                        else
                        {
                            <span class="page-btn disabled" aria-disabled="true">Next ›</span>
                        }
                    </nav>
                }
            }
        </section>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    private CompanyDetailDto? company;
    private PagedResponse<CompanyReviewDto>? reviews;
    private bool isLoading = true;
    private string? loadError;

    private string JobsUrl => $"/it-jobs?companyId={Id}";

    private string PageUrl(int page) => $"/companies/{Id}?page={page}";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;
        company = null;
        reviews = null;

        if (Id <= 0)
        {
            loadError = "not-found";
            isLoading = false;
            return;
        }

        try
        {
            var result = await CompanyService.GetDetailAsync(Id);
            if (result.Success && result.Data is not null)
            {
                company = result.Data;
            }
            else if (result.ErrorType == ServiceErrorType.NotFound)
            {
                loadError = "not-found";
            }
            else
            {
                loadError = result.Errors.FirstOrDefault() ?? "We could not load this company right now.";
            }
        }
        catch
        {
            loadError = "We could not load this company right now.";
        }

        isLoading = false;
        if (company is null)
        {
            return;
        }

        var reviewResult = await CompanyService.GetReviewsAsync(Id, Page <= 0 ? 1 : Page);
        if (reviewResult.Success)
        {
            reviews = reviewResult.Data;
        }
    }

    private static string Initials(string name) =>
        string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();

    private static string Stars(int score)
    {
        var filled = Math.Clamp(score, 0, 5);
        return new string('★', filled) + new string('☆', 5 - filled);
    }

    private static string ScaleLabel(CompanyScale scale) => scale switch
    {
        CompanyScale.LessThan10 => "1–10 employees",
        CompanyScale.From10To49 => "10–49 employees",
        CompanyScale.From50To199 => "50–199 employees",
        CompanyScale.From200To499 => "200–499 employees",
        CompanyScale.MoreThan500 => "500+ employees",
        _ => scale.ToString()
    };
}
