@page "/employer/jobs"
@implements IDisposable
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using hotjob.DTOs.Job
@using hotjob.Models.Job
@using hotjob.Services.Job
@inject IJobService JobService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthSession AuthSession

<PageTitle>Jobs &amp; Postings | HotJob</PageTitle>

<AuthorizeView Roles="Employer">
    <Authorized Context="auth">
        <div class="ej-page workspace">
            <section class="workspace-header">
                <div class="workspace-header-copy">
                    <p class="workspace-eyebrow">Employer workspace</p>
                    <h1>Jobs &amp; postings</h1>
                    <p class="workspace-lede">Create roles, publish them, and keep every applicant moving. Drafts delete permanently; closing a published role rejects open applications and records it on each one.</p>
                </div>
                <div class="workspace-actions">
                    <button class="workspace-btn workspace-btn-primary" type="button" @onclick="OpenCreateForm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                        Post a job
                    </button>
                </div>
            </section>

            @if (isLoading)
            {
                <section class="workspace-card" aria-busy="true" aria-label="Loading job postings">
                    <div class="ej-skeleton-grid">
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                    </div>
                    <div class="workspace-skeleton" style="height:260px;margin-top:16px"></div>
                    <p class="visually-hidden" role="status">Loading your job postings…</p>
                </section>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="workspace-alert" role="alert">@loadError</div>
            }
            else
            {
                <section class="workspace-metrics" aria-label="Posting overview">
                    <button class="workspace-stat @(statusFilter == JobStatus.Published ? "is-active" : string.Empty)" type="button" aria-pressed="@(statusFilter == JobStatus.Published ? "true" : "false")" @onclick="() => FilterByStatusAsync(JobStatus.Published)">
                        <span class="workspace-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12l4 4L19 6" /></svg></span>
                        <span class="workspace-stat-label">Active</span>
                        <span class="workspace-stat-value">@publishedCount</span>
                        <span class="workspace-stat-hint">Accepting applications</span>
                    </button>
                    <button class="workspace-stat @(statusFilter == JobStatus.Draft ? "is-active" : string.Empty)" type="button" aria-pressed="@(statusFilter == JobStatus.Draft ? "true" : "false")" @onclick="() => FilterByStatusAsync(JobStatus.Draft)">
                        <span class="workspace-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10-10-4-4L4 16v4z" /><path d="M13 5l4 4" /></svg></span>
                        <span class="workspace-stat-label">Drafts</span>
                        <span class="workspace-stat-value">@draftCount</span>
                        <span class="workspace-stat-hint">Editable and safe to remove</span>
                    </button>
                    <a class="workspace-stat" href="/employer/interviews">
                        <span class="workspace-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3" /><path d="M3 19c.8-3 3.1-4.5 6-4.5s5.2 1.5 6 4.5" /><path d="M16 8h5M18.5 5.5v5" /></svg></span>
                        <span class="workspace-stat-label">Applicants</span>
                        <span class="workspace-stat-value">@jobs.Sum(j => j.ApplicationsCount)</span>
                        <span class="workspace-stat-hint">Across the roles on this page</span>
                    </a>
                    <button class="workspace-stat @(statusFilter == JobStatus.Closed || statusFilter == JobStatus.Expired ? "is-active" : string.Empty)" type="button" aria-pressed="@(statusFilter == JobStatus.Closed || statusFilter == JobStatus.Expired ? "true" : "false")" @onclick="() => FilterByStatusAsync(JobStatus.Closed)">
                        <span class="workspace-stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="8" /><path d="M9 12h6" /></svg></span>
                        <span class="workspace-stat-label">Closed / expired</span>
                        <span class="workspace-stat-value">@(closedCount + expiredCount)</span>
                        <span class="workspace-stat-hint">Archived from the job board</span>
                    </button>
                </section>

                <details class="workspace-details ej-rules">
                    <summary>Posting rules &amp; guardrails</summary>
                    <div class="workspace-details-body">
                        <p><strong>Validation:</strong> salary min cannot exceed max, expiry must be in the future, and every skill or category id must exist.</p>
                        <p><strong>Closing:</strong> a published role moves to Closed, mass-rejects open applications, and writes a “Job closed” history entry on each application. Drafts are deleted permanently.</p>
                    </div>
                </details>

                @if (!string.IsNullOrWhiteSpace(actionMessage))
                {
                    <div class="workspace-notice" role="status" aria-live="polite">@actionMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(actionError))
                {
                    <div class="workspace-alert" role="alert" aria-live="assertive">@actionError</div>
                }

                <section class="workspace-toolbar" aria-label="Job filters">
                    <label class="workspace-field workspace-field-grow">
                        <span>Search</span>
                        <InputText @bind-Value="search" placeholder="Title, skill or category" />
                    </label>
                    <label class="workspace-field">
                        <span>Status</span>
                        <InputSelect @bind-Value="statusFilter">
                            <option value="">All statuses</option>
                            @foreach (var s in Enum.GetValues<JobStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </InputSelect>
                    </label>
                    <div class="workspace-toolbar-actions">
                        <button class="workspace-btn workspace-btn-primary" type="button" @onclick="SearchAsync">Apply filters</button>
                        @if (HasFilters)
                        {
                            <button class="workspace-btn workspace-btn-ghost" type="button" @onclick="ClearFiltersAsync">Clear</button>
                        }
                    </div>
                </section>

                @if (showForm)
                {
                    <section class="workspace-card" aria-label="@(editingId is null ? "Post a new job" : "Edit job")">
                        <div class="workspace-section-head">
                            <div>
                                <h2>@(editingId is null ? "Post a new job" : $"Edit job #{editingId}")</h2>
                                <p class="workspace-sub">Status may only be Draft or Published. Close a live role from the table.</p>
                            </div>
                            <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button" @onclick="CloseForm">Close</button>
                        </div>
                        <EditForm Model="jobForm" OnValidSubmit="SaveAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <fieldset class="workspace-fieldset">
                                <legend>Role basics</legend>
                                <label class="workspace-field workspace-wide">
                                    <span>Title</span>
                                    <InputText @bind-Value="jobForm.Title" placeholder="e.g. Senior .NET Developer" />
                                </label>
                                <label class="workspace-field workspace-wide">
                                    <span>Description</span>
                                    <InputTextArea @bind-Value="jobForm.Description" rows="5" placeholder="What the role owns, the team, and the outcomes you expect." />
                                </label>
                            </fieldset>
                            <fieldset class="workspace-fieldset">
                                <legend>Compensation &amp; requirements</legend>
                                <label class="workspace-field">
                                    <span>Salary min</span>
                                    <InputNumber @bind-Value="jobForm.SalaryMin" />
                                </label>
                                <label class="workspace-field">
                                    <span>Salary max</span>
                                    <InputNumber @bind-Value="jobForm.SalaryMax" />
                                </label>
                                <label class="workspace-field">
                                    <span>Experience required (years)</span>
                                    <InputNumber @bind-Value="jobForm.ExperienceRequired" />
                                </label>
                                <label class="workspace-field">
                                    <span>Job type</span>
                                    <InputSelect @bind-Value="jobForm.JobType">
                                        @foreach (var t in Enum.GetValues<JobType>())
                                        {
                                            <option value="@t">@t</option>
                                        }
                                    </InputSelect>
                                </label>
                            </fieldset>
                            <fieldset class="workspace-fieldset">
                                <legend>Timeline &amp; visibility</legend>
                                <label class="workspace-field">
                                    <span>Expiry date</span>
                                    <InputDate @bind-Value="jobForm.ExpiryDate" />
                                </label>
                                <label class="workspace-field">
                                    <span>Status</span>
                                    <InputSelect @bind-Value="jobForm.Status">
                                        <option value="@JobStatus.Draft">Draft</option>
                                        <option value="@JobStatus.Published">Published</option>
                                    </InputSelect>
                                </label>
                            </fieldset>
                            <fieldset class="workspace-fieldset">
                                <legend>Matching taxonomy</legend>
                                <label class="workspace-field workspace-wide">
                                    <span>Category ids</span>
                                    <InputText @bind-Value="categoryText" placeholder="e.g. 1, 2" />
                                    <span class="workspace-hint">Numeric taxonomy ids separated by commas.</span>
                                </label>
                                <label class="workspace-field workspace-wide">
                                    <span>Skills as id:weight</span>
                                    <InputText @bind-Value="skillText" placeholder="e.g. 3:8, 5:6" />
                                    <span class="workspace-hint">Comma-separated skill id and importance from 0–10. Example: 3:8 means skill 3 at weight 8.</span>
                                </label>
                            </fieldset>
                            <div class="workspace-form-actions">
                                <button class="workspace-btn workspace-btn-primary" type="submit" disabled="@isSaving">@(isSaving ? "Saving…" : editingId is null ? "Post job" : "Save changes")</button>
                                <button class="workspace-btn workspace-btn-secondary" type="button" @onclick="CloseForm">Cancel</button>
                            </div>
                        </EditForm>
                    </section>
                }

                <section class="workspace-card ej-table-card" aria-label="Job postings">
                    <div class="workspace-section-head">
                        <div>
                            <h2>All postings</h2>
                            <p class="workspace-sub">@totalCount role@(totalCount == 1 ? string.Empty : "s") match@(totalCount == 1 ? "es" : string.Empty) the current view.</p>
                        </div>
                    </div>
                    <div class="ej-table-scroll">
                        <table class="ej-table">
                            <thead>
                                <tr><th>Role</th><th>Status</th><th>Applicants</th><th>Salary</th><th>Expiry</th><th><span class="visually-hidden">Actions</span></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var job in jobs)
                                {
                                    <tr class="@(selected?.Id == job.Id ? "is-selected" : string.Empty)">
                                        <td data-label="Role">
                                            <button class="ej-title-button" type="button" @onclick="() => ViewDetailAsync(job.Id)">@job.Title</button>
                                            <p class="ej-job-meta">@job.JobType · @job.ExperienceRequired yr exp · posted @job.CreatedAt.ToString("dd MMM")</p>
                                            @if (job.CategoryNames.Count > 0)
                                            {
                                                <div class="workspace-chip-row ej-job-chips">
                                                    @foreach (var category in job.CategoryNames.Take(3))
                                                    {
                                                        <span class="workspace-chip">@category</span>
                                                    }
                                                    @if (job.CategoryNames.Count > 3)
                                                    {
                                                        <span class="workspace-chip">+@(job.CategoryNames.Count - 3)</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td data-label="Status"><span class="workspace-badge @StatusClass(job.Status)">@job.Status</span></td>
                                        <td data-label="Applicants">
                                            <a class="ej-applicant-link" href="/employer/interviews?jobId=@job.Id">
                                                <strong>@job.ApplicationsCount</strong>
                                                <span>@(job.ApplicationsCount == 1 ? "applicant" : "applicants")</span>
                                            </a>
                                        </td>
                                        <td data-label="Salary">@SalaryRange(job)</td>
                                        <td data-label="Expiry">@(job.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                        <td data-label="Actions">
                                            <div class="ej-row-actions">
                                                <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" @onclick="() => ViewDetailAsync(job.Id)">View</button>
                                                <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" @onclick="() => OpenEditFormAsync(job.Id)">Edit</button>
                                                @if (job.Status == JobStatus.Draft || job.Status == JobStatus.Published)
                                                {
                                                    <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button" @onclick="() => DeleteOrCloseAsync(job.Id, job.Title, job.Status)">
                                                        @(pendingDeleteId == job.Id ? "Confirm " + (job.Status == JobStatus.Draft ? "delete?" : "close?") : job.Status == JobStatus.Draft ? "Delete" : "Close")
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (jobs.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="workspace-empty">
                                                <span class="workspace-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16v13H4z" /><path d="M9 7V4h6v3" /></svg></span>
                                                <h3>No postings match this view</h3>
                                                <p>Clear the filters to see everything, or post a new role to start collecting applicants.</p>
                                                @if (HasFilters)
                                                {
                                                    <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" @onclick="ClearFiltersAsync">Clear filters</button>
                                                }
                                                else
                                                {
                                                    <button class="workspace-btn workspace-btn-primary workspace-btn-small" type="button" @onclick="OpenCreateForm">Post a job</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <div class="workspace-pagination">
                    <span>@(totalCount == 0 ? "No postings" : $"Showing {FromResult}–{ToResult} of {totalCount}")</span>
                    <div class="workspace-pagination-actions">
                        <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" disabled="@(page <= 1)" @onclick="() => ChangePageAsync(page - 1)">← Previous</button>
                        <span class="ej-page-count">Page @(page) of @(Math.Max(totalPages, 1))</span>
                        <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" disabled="@(page >= totalPages)" @onclick="() => ChangePageAsync(page + 1)">Next →</button>
                    </div>
                </div>

                @if (selected is not null)
                {
                    <section class="workspace-card ej-detail" aria-label="Job detail">
                        <div class="workspace-section-head">
                            <div>
                                <p class="workspace-eyebrow">Job #@selected.Id</p>
                                <h2>@selected.Title</h2>
                                <p class="workspace-sub">@selected.CompanyName · @selected.ApplicationsCount application@(selected.ApplicationsCount == 1 ? string.Empty : "s")</p>
                            </div>
                            <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button" @onclick="() => selected = null">Close</button>
                        </div>
                        <dl class="workspace-meta ej-detail-meta">
                            <div><dt>Status</dt><dd><span class="workspace-badge @StatusClass(selected.Status)">@selected.Status</span></dd></div>
                            <div><dt>Salary</dt><dd>@SalaryDetail(selected)</dd></div>
                            <div><dt>Job type</dt><dd>@selected.JobType</dd></div>
                            <div><dt>Experience</dt><dd>@selected.ExperienceRequired year@(selected.ExperienceRequired == 1 ? string.Empty : "s")</dd></div>
                            <div><dt>Expiry</dt><dd>@(selected.ExpiryDate?.ToString("dd MMM yyyy") ?? "No deadline")</dd></div>
                            <div><dt>Posted</dt><dd>@selected.CreatedAt.ToString("dd MMM yyyy")</dd></div>
                        </dl>
                        <div class="workspace-chip-row ej-detail-chips">
                            @foreach (var c in selected.Categories)
                            {
                                <span class="workspace-chip">@c.Name</span>
                            }
                            @foreach (var s in selected.Skills)
                            {
                                <span class="workspace-chip">@s.SkillName · @s.ImportanceWeight/10</span>
                            }
                        </div>
                        <div class="ej-detail-desc">@selected.Description</div>
                        <div class="workspace-form-actions">
                            <a class="workspace-btn workspace-btn-secondary" href="/employer/interviews?jobId=@selected.Id">View applicants</a>
                            <button class="workspace-btn workspace-btn-ghost" type="button" @onclick="() => EditFromDetailAsync(selected.Id)">Edit job</button>
                        </div>
                    </section>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isLoading = true;
    private bool hasLoadedOnce;
    private bool isSaving;
    private string? loadError;
    private string? actionMessage;
    private string? actionError;
    private string? search;
    private JobStatus? statusFilter;
    private int page = 1;
    private const int PageSize = 10;
    private int totalCount;
    private int totalPages;
    private int draftCount, publishedCount, closedCount, expiredCount;
    private List<JobListItemResponse> jobs = new();
    private JobDetailResponse? selected;
    private bool showForm;
    private int? editingId;
    private int? pendingDeleteId;
    private CreateJobRequest jobForm = new();
    private string categoryText = string.Empty;
    private string skillText = string.Empty;

    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        if (AuthSession.IsAuthenticated)
        {
            _ = LoadAsync();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

    private async Task<string> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub") ?? string.Empty;
    }

    private async Task LoadAsync()
    {
        // Blazor calls LoadAsync from several event handlers; a second load while one is
        // in flight must not overlap it: HttpClient calls sharing circuit state kill the circuit.
        if (isLoading && hasLoadedOnce)
        {
            return;
        }
        isLoading = true;
        hasLoadedOnce = true;
        loadError = null;
        try
        {
            var userId = await GetUserIdAsync();
            var main = await JobService.ListAsync(userId, statusFilter, search, page, PageSize);
            if (!main.Success || main.Data is null)
            {
                loadError = main.Errors.FirstOrDefault() ?? "We could not load your job postings.";
                return;
            }
            jobs = main.Data.Items.ToList();
            totalCount = main.Data.TotalCount;
            totalPages = main.Data.TotalPages;
            // Sequential awaits: never Task.WhenAll calls sharing circuit state.
            // ponytail: 4 round-trips for status counts; collapse to one GROUP BY query when this gets slow.
            var draft = await JobService.ListAsync(userId, JobStatus.Draft, null, 1, 1);
            var published = await JobService.ListAsync(userId, JobStatus.Published, null, 1, 1);
            var closed = await JobService.ListAsync(userId, JobStatus.Closed, null, 1, 1);
            var expired = await JobService.ListAsync(userId, JobStatus.Expired, null, 1, 1);
            draftCount = draft.Data?.TotalCount ?? 0;
            publishedCount = published.Data?.TotalCount ?? 0;
            closedCount = closed.Data?.TotalCount ?? 0;
            expiredCount = expired.Data?.TotalCount ?? 0;
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int next)
    {
        page = next;
        await LoadAsync();
    }

    private bool HasFilters => !string.IsNullOrWhiteSpace(search) || statusFilter.HasValue;

    private int FromResult => totalCount == 0 ? 0 : ((page - 1) * PageSize) + 1;

    private int ToResult => Math.Min(page * PageSize, totalCount);

    private async Task FilterByStatusAsync(JobStatus status)
    {
        statusFilter = statusFilter == status ? null : status;
        page = 1;
        await LoadAsync();
    }

    private async Task ClearFiltersAsync()
    {
        search = null;
        statusFilter = null;
        page = 1;
        await LoadAsync();
    }

    private async Task EditFromDetailAsync(int id)
    {
        selected = null;
        await OpenEditFormAsync(id);
    }

    private void OpenCreateForm()
    {
        editingId = null;
        jobForm = new CreateJobRequest();
        categoryText = skillText = string.Empty;
        actionMessage = actionError = null;
        showForm = true;
    }

    private async Task OpenEditFormAsync(int id)
    {
        actionMessage = actionError = null;
        var result = await JobService.GetAsync(await GetUserIdAsync(), id);
        if (!result.Success || result.Data is null)
        {
            actionError = result.Errors.FirstOrDefault() ?? "Could not load this job.";
            return;
        }
        var d = result.Data;
        editingId = d.Id;
        jobForm = new UpdateJobRequest
        {
            Title = d.Title,
            Description = d.Description,
            SalaryMin = d.SalaryMin,
            SalaryMax = d.SalaryMax,
            ExperienceRequired = d.ExperienceRequired,
            JobType = d.JobType,
            ExpiryDate = d.ExpiryDate,
            Status = d.Status,
            CategoryIds = d.Categories.Select(c => c.Id).ToList(),
            Skills = d.Skills.Select(s => new JobSkillInput { SkillId = s.SkillId, ImportanceWeight = s.ImportanceWeight }).ToList()
        };
        categoryText = string.Join(", ", jobForm.CategoryIds);
        skillText = string.Join(", ", jobForm.Skills.Select(s => $"{s.SkillId}:{s.ImportanceWeight}"));
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = null;
    }

    private async Task SaveAsync()
    {
        actionMessage = actionError = null;
        if (!TryParseTaxonomy(out var error))
        {
            actionError = error;
            return;
        }
        isSaving = true;
        var userId = await GetUserIdAsync();
        if (editingId is null)
        {
            var created = await JobService.CreateAsync(userId, jobForm);
            actionMessage = created.Success ? $"Job \"{created.Data!.Title}\" posted as {created.Data.Status}." : null;
            actionError = created.Success ? null : created.Errors.FirstOrDefault() ?? "Could not post this job.";
            if (created.Success)
            {
                showForm = false;
                // A newly created Draft is hidden whenever a Status/Search filter is
                // active, so the reload below would look like the post "didn't work"
                // until a manual refresh. Drop the filter/paging so the new posting is
                // visible immediately (newest first, page 1).
                search = null;
                statusFilter = null;
                page = 1;
            }
        }
        else
        {
            var updated = await JobService.UpdateAsync(userId, editingId.Value, (UpdateJobRequest)jobForm);
            actionMessage = updated.Success ? $"Job \"{updated.Data!.Title}\" updated." : null;
            actionError = updated.Success ? null : updated.Errors.FirstOrDefault() ?? "Could not update this job.";
            if (updated.Success) showForm = false;
        }
        isSaving = false;
        await LoadAsync();
    }

    private bool TryParseTaxonomy(out string? error)
    {
        error = null;
        try
        {
            jobForm.CategoryIds = categoryText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(int.Parse).ToList();
            jobForm.Skills = skillText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(part =>
                {
                    var pieces = part.Split(':');
                    return new JobSkillInput { SkillId = int.Parse(pieces[0]), ImportanceWeight = pieces.Length > 1 ? double.Parse(pieces[1]) : 1.0 };
                }).ToList();
            return true;
        }
        catch
        {
            error = "Category ids must be numbers (e.g. 1, 2); skills must look like id:weight (e.g. 3:8, 5:6).";
            return false;
        }
    }

    private async Task ViewDetailAsync(int id)
    {
        actionError = null;
        var result = await JobService.GetAsync(await GetUserIdAsync(), id);
        selected = result.Success ? result.Data : null;
        if (!result.Success) actionError = result.Errors.FirstOrDefault() ?? "Could not load this job.";
    }

    private async Task DeleteOrCloseAsync(int id, string title, JobStatus status)
    {
        actionMessage = actionError = null;
        if (pendingDeleteId != id)
        {
            pendingDeleteId = id;
            return;
        }
        pendingDeleteId = null;
        var result = await JobService.DeleteOrCloseAsync(await GetUserIdAsync(), id);
        if (result.Success && result.Data is not null)
            actionMessage = result.Data.Closed ? $"Job \"{title}\" closed — open applications mass-rejected." : $"Draft \"{title}\" permanently deleted.";
        else
            actionError = result.Errors.FirstOrDefault() ?? "Could not remove this job.";
        if (selected?.Id == id) selected = null;
        await LoadAsync();
    }

    private static string StatusClass(JobStatus status) => status switch
    {
        JobStatus.Published => "is-published",
        JobStatus.Draft => "is-draft",
        JobStatus.Closed => "is-closed",
        JobStatus.Expired => "is-expired",
        _ => "is-muted"
    };

    private static string SalaryRange(JobListItemResponse j) =>
        (j.SalaryMin, j.SalaryMax) switch
        {
            (null, null) => "Negotiable",
            (not null, null) => $"From {j.SalaryMin:N0}",
            (null, not null) => $"Up to {j.SalaryMax:N0}",
            _ => $"{j.SalaryMin:N0} – {j.SalaryMax:N0}"
        };

    private static string SalaryDetail(JobDetailResponse d) =>
        (d.SalaryMin, d.SalaryMax) switch
        {
            (null, null) => "Negotiable",
            (not null, null) => $"From {d.SalaryMin:N0}",
            (null, not null) => $"Up to {d.SalaryMax:N0}",
            _ => $"{d.SalaryMin:N0} – {d.SalaryMax:N0}"
        };
}
