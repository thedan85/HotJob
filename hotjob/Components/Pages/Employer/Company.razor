@page "/employer/company"
@implements IDisposable
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using hotjob.DTOs.Employer
@using hotjob.Models.Users
@using hotjob.Services.Employer
@inject ICompanyService CompanyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthSession AuthSession

<PageTitle>Company &amp; team | HotJob</PageTitle>

<AuthorizeView Roles="Employer">
    <Authorized Context="auth">
        <div class="ec-page workspace">
            <section class="workspace-header ec-header">
                <div class="workspace-header-copy">
                    <p class="workspace-eyebrow">Employer workspace</p>
                    <h1>Company &amp; team</h1>
                    <p class="workspace-lede">Keep the profile candidates see accurate, and decide who can work with your postings and applicants.</p>
                    @if (companyPage is not null)
                    {
                        <div class="ec-header-facts">
                            <div><span>Company ID</span><strong>#@companyPage.Company.Id</strong></div>
                            <div><span>Your role</span><strong>@(companyPage.IsOwner ? "Owner" : "Member")</strong></div>
                            <div><span>Team</span><strong>@ActiveMembers.Count active</strong></div>
                        </div>
                    }
                </div>
                @if (companyPage is not null)
                {
                    <div class="ec-status-card" role="status" aria-label="Company verification status">
                        <span class="ec-status-label">Company status</span>
                        <span class="workspace-badge @StatusClass(companyPage.Company.Status)">@StatusLabel(companyPage.Company.Status)</span>
                        <h2>@companyPage.Company.CompanyName</h2>
                        <p>@StatusExplanation</p>
                    </div>
                }
            </section>

            @if (isLoading)
            {
                <section class="workspace-card" aria-busy="true" aria-label="Loading company profile">
                    <div class="ec-skeleton-grid">
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                    </div>
                    <div class="workspace-skeleton" style="height:220px;margin-top:16px"></div>
                    <p class="visually-hidden" role="status">Loading your company…</p>
                </section>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="workspace-alert" role="alert">@loadError</div>
            }
            else if (companyPage is not null)
            {
                <section class="workspace-metrics" aria-label="Company overview">
                    <button class="workspace-stat" type="button" @onclick='() => ShowTab("team")'>
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3" /><path d="M3 19c.8-3 3.1-4.5 6-4.5s5.2 1.5 6 4.5" /><path d="M16 11a3 3 0 1 0 0-6" /><path d="M17 14.5c2.2.4 3.6 1.9 4 4.5" /></svg>
                        </span>
                        <span class="workspace-stat-label">Team members</span>
                        <span class="workspace-stat-value">@ActiveMembers.Count</span>
                        <span class="workspace-stat-hint">Approved and active</span>
                    </button>
                    <button class="workspace-stat" type="button" @onclick='() => ShowTab("team")'>
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3" /><path d="M5 20c.8-3.4 3.3-5 7-5s6.2 1.6 7 5" /><path d="M18 4v6M15 7h6" /></svg>
                        </span>
                        <span class="workspace-stat-label">Join requests</span>
                        <span class="workspace-stat-value">@PendingMembers.Count</span>
                        <span class="workspace-stat-hint">@(companyPage.IsOwner ? "Waiting for your review" : "The owner reviews these")</span>
                    </button>
                    <button class="workspace-stat" type="button" @onclick='() => ShowTab("profile")'>
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V6a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" /><path d="M8 12h8M8 16h5" /></svg>
                        </span>
                        <span class="workspace-stat-label">Profile complete</span>
                        <span class="workspace-stat-value">@ProfilePercent%</span>
                        <span class="workspace-stat-hint">@ProfileFieldsComplete of 5 details added</span>
                    </button>
                    <button class="workspace-stat" type="button" @onclick='() => ShowTab("compliance")'>
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.4-3 7.4-7 9-4-1.6-7-4.6-7-9V6l7-3z" /><path d="M9 12l2 2 4-4" /></svg>
                        </span>
                        <span class="workspace-stat-label">Verification</span>
                        <span class="workspace-stat-value ec-status-value">@StatusLabel(companyPage.Company.Status)</span>
                        <span class="workspace-stat-hint">Set by HotJob operations</span>
                    </button>
                </section>

                <nav class="workspace-tabs" aria-label="Company sections">
                    <button class="workspace-tab" type="button" aria-pressed="@(activeTab == "team" ? "true" : "false")" @onclick='() => ShowTab("team")'>
                        Team
                        @if (PendingMembers.Count > 0)
                        {
                            <span class="ec-tab-count">@PendingMembers.Count</span>
                        }
                    </button>
                    <button class="workspace-tab" type="button" aria-pressed="@(activeTab == "profile" ? "true" : "false")" @onclick='() => ShowTab("profile")'>Profile</button>
                    <button class="workspace-tab" type="button" aria-pressed="@(activeTab == "compliance" ? "true" : "false")" @onclick='() => ShowTab("compliance")'>Verification</button>
                    <button class="workspace-tab" type="button" aria-pressed="@(activeTab == "audit" ? "true" : "false")" @onclick='() => ShowTab("audit")'>Activity</button>
                </nav>

                @if (activeTab == "team")
                {
                    <div class="ec-panel" role="region" aria-label="Team members and permissions">
                        <section class="workspace-card">
                            <div class="workspace-section-head">
                                <div>
                                    <h2>Join requests</h2>
                                    <p class="workspace-sub">People who chose your company at sign-up stay pending until the owner approves them.</p>
                                </div>
                                @if (PendingMembers.Count > 0)
                                {
                                    <span class="workspace-badge is-pending">@PendingMembers.Count waiting</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(notice))
                            {
                                <div class="@(noticeIsError ? "workspace-alert" : "workspace-notice")" role="@(noticeIsError ? "alert" : "status")" aria-live="polite">@notice</div>
                            }

                            @if (PendingMembers.Count == 0)
                            {
                                <div class="workspace-empty">
                                    <span class="workspace-empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6" /></svg>
                                    </span>
                                    <h3>No one is waiting</h3>
                                    <p>New join requests appear here for the owner to approve. Active members can use the applicant workspace immediately.</p>
                                </div>
                            }
                            else
                            {
                                <div class="ec-request-grid">
                                    @foreach (var member in PendingMembers)
                                    {
                                        <article class="ec-request">
                                            <span class="workspace-avatar" aria-hidden="true">@Initials(member.FullName)</span>
                                            <div class="ec-request-copy">
                                                <strong>@member.FullName</strong>
                                                <span>@(string.IsNullOrWhiteSpace(member.Position) ? "Team member" : member.Position)</span>
                                                <span>@(string.IsNullOrWhiteSpace(member.Email) ? "Email not shared" : member.Email)</span>
                                            </div>
                                            @if (companyPage.IsOwner)
                                            {
                                                <div class="ec-request-actions">
                                                    <button class="workspace-btn workspace-btn-primary workspace-btn-small" type="button" disabled="@isActing" @onclick="() => ApproveAsync(member.Id, member.FullName)">Approve</button>
                                                    <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button" disabled="@isActing" @onclick="() => RejectAsync(member.Id, member.FullName)">Reject</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="workspace-badge is-pending">Owner approval</span>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>

                        <section class="workspace-card">
                            <div class="workspace-section-head">
                                <div>
                                    <h2>Active members</h2>
                                    <p class="workspace-sub">These people can view applicants, schedule interviews and manage postings.</p>
                                </div>
                                <span class="workspace-badge is-active">@ActiveMembers.Count total</span>
                            </div>

                            @if (ActiveMembers.Count == 0)
                            {
                                <div class="workspace-empty">
                                    <h3>No active members yet</h3>
                                    <p>Approve a join request to give someone access.</p>
                                </div>
                            }
                            else
                            {
                                <ul class="ec-member-list">
                                    @foreach (var member in ActiveMembers)
                                    {
                                        <li class="ec-member">
                                            <span class="workspace-avatar workspace-avatar-sm" aria-hidden="true">@Initials(member.FullName)</span>
                                            <div class="ec-member-copy">
                                                <strong>@member.FullName</strong>
                                                <span>@(string.IsNullOrWhiteSpace(member.Position) ? "Team member" : member.Position)@(string.IsNullOrWhiteSpace(member.Email) ? string.Empty : $" · {member.Email}")</span>
                                            </div>
                                            <span class="workspace-badge @(member.IsOwner ? "is-owner" : "is-active")">@(member.IsOwner ? "Owner" : "Active")</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>
                }
                else if (activeTab == "profile")
                {
                    <section class="workspace-card" role="region" aria-label="Company profile">
                        <div class="workspace-section-head">
                            <div>
                                <h2>Company profile</h2>
                                <p class="workspace-sub">@(companyPage.IsOwner ? "This is what candidates see. Only the owner can change it." : "This is what candidates see. Only the company owner can change it.")</p>
                            </div>
                            @if (companyPage.IsOwner && !editing)
                            {
                                <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" @onclick="BeginEdit">Edit profile</button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(savedMessage))
                        {
                            <div class="@(savedIsError ? "workspace-alert" : "workspace-notice")" role="@(savedIsError ? "alert" : "status")" aria-live="polite">@savedMessage</div>
                        }

                        @if (!editing)
                        {
                            <dl class="ec-facts">
                                <div>
                                    <dt>Company name</dt>
                                    <dd>@companyPage.Company.CompanyName</dd>
                                </div>
                                <div>
                                    <dt>Website</dt>
                                    <dd>
                                        @if (!string.IsNullOrWhiteSpace(SafeWebsite(companyPage.Company.Website)))
                                        {
                                            <a class="workspace-link" href="@SafeWebsite(companyPage.Company.Website)" target="_blank" rel="noopener noreferrer">@companyPage.Company.Website</a>
                                        }
                                        else
                                        {
                                            <span class="ec-muted">Not added</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt>Industry</dt>
                                    <dd class="@(string.IsNullOrWhiteSpace(companyPage.Company.Industry) ? "ec-muted" : string.Empty)">@(companyPage.Company.Industry ?? "Not added")</dd>
                                </div>
                                <div>
                                    <dt>Location</dt>
                                    <dd class="@(string.IsNullOrWhiteSpace(companyPage.Company.Location) ? "ec-muted" : string.Empty)">@(companyPage.Company.Location ?? "Not added")</dd>
                                </div>
                                <div>
                                    <dt>Company size</dt>
                                    <dd class="@(companyPage.Company.Scale.HasValue ? string.Empty : "ec-muted")">@ScaleLabel(companyPage.Company.Scale)</dd>
                                </div>
                                <div class="ec-facts-wide">
                                    <dt>About the company</dt>
                                    <dd class="@(string.IsNullOrWhiteSpace(companyPage.Company.Description) ? "ec-muted" : string.Empty)">@(companyPage.Company.Description ?? "No description yet. Candidates use this to understand what you do and how you work.")</dd>
                                </div>
                            </dl>
                        }
                        else
                        {
                            <EditForm Model="companyForm" OnValidSubmit="SaveAsync">
                                <DataAnnotationsValidator />
                                <div class="workspace-form-grid">
                                    <label class="workspace-field">
                                        <span>Company name</span>
                                        <InputText @bind-Value="companyName" disabled="true" />
                                        <span class="workspace-hint">Company names are changed by HotJob operations.</span>
                                    </label>
                                    <label class="workspace-field">
                                        <span>Website</span>
                                        <InputText @bind-Value="companyForm.Website" placeholder="https://example.com" />
                                        <ValidationMessage For="() => companyForm.Website" />
                                    </label>
                                    <label class="workspace-field">
                                        <span>Industry</span>
                                        <InputText @bind-Value="companyForm.Industry" placeholder="Software, retail, healthcare…" />
                                        <ValidationMessage For="() => companyForm.Industry" />
                                    </label>
                                    <label class="workspace-field">
                                        <span>Location</span>
                                        <InputText @bind-Value="companyForm.Location" placeholder="City or region" />
                                        <ValidationMessage For="() => companyForm.Location" />
                                    </label>
                                    <label class="workspace-field">
                                        <span>Company size</span>
                                        <InputSelect @bind-Value="companyForm.Scale">
                                            <option value="">Choose a size</option>
                                            @foreach (var scale in Enum.GetValues<CompanyScale>())
                                            {
                                                <option value="@scale">@ScaleLabel(scale)</option>
                                            }
                                        </InputSelect>
                                    </label>
                                    <label class="workspace-field workspace-wide">
                                        <span>About the company</span>
                                        <InputTextArea @bind-Value="companyForm.Description" rows="4" placeholder="What the company does, how the team works, and what candidates can expect." />
                                        <ValidationMessage For="() => companyForm.Description" />
                                    </label>
                                </div>
                                <div class="workspace-form-actions">
                                    <button class="workspace-btn workspace-btn-primary" type="submit" disabled="@isActing">@(isActing ? "Saving…" : "Save profile")</button>
                                    <button class="workspace-btn workspace-btn-secondary" type="button" disabled="@isActing" @onclick="CancelEdit">Cancel</button>
                                </div>
                            </EditForm>
                        }
                    </section>
                }
                else if (activeTab == "compliance")
                {
                    <section class="workspace-card" role="region" aria-label="Company verification">
                        <div class="workspace-section-head">
                            <div>
                                <h2>Verification</h2>
                                <p class="workspace-sub">HotJob operations checks every company before it can hire on the platform.</p>
                            </div>
                            <span class="workspace-badge @StatusClass(companyPage.Company.Status)">@StatusLabel(companyPage.Company.Status)</span>
                        </div>

                        <div class="ec-compliance-grid">
                            <div class="ec-compliance-card">
                                <span class="ec-compliance-label">Current status</span>
                                <strong>@StatusLabel(companyPage.Company.Status)</strong>
                                <p>@StatusExplanation</p>
                            </div>
                            <div class="ec-compliance-card">
                                <span class="ec-compliance-label">Profile completeness</span>
                                <strong>@ProfilePercent%</strong>
                                <div class="ec-progress" role="img" aria-label="@(ProfilePercent + " percent of company profile details added")">
                                    <span style="width:@(ProfilePercent)%"></span>
                                </div>
                                <p>@ProfileFieldsComplete of 5 details added. A complete profile helps the review go faster.</p>
                            </div>
                        </div>

                        <div class="ec-checklist">
                            <h3>Profile details</h3>
                            <ul>
                                <li class="@CheckClass(!string.IsNullOrWhiteSpace(companyPage.Company.Website))">
                                    <span aria-hidden="true">@(!string.IsNullOrWhiteSpace(companyPage.Company.Website) ? "✓" : "○")</span> Website added
                                </li>
                                <li class="@CheckClass(!string.IsNullOrWhiteSpace(companyPage.Company.Industry))">
                                    <span aria-hidden="true">@(!string.IsNullOrWhiteSpace(companyPage.Company.Industry) ? "✓" : "○")</span> Industry selected
                                </li>
                                <li class="@CheckClass(!string.IsNullOrWhiteSpace(companyPage.Company.Location))">
                                    <span aria-hidden="true">@(!string.IsNullOrWhiteSpace(companyPage.Company.Location) ? "✓" : "○")</span> Location added
                                </li>
                                <li class="@CheckClass(companyPage.Company.Scale.HasValue)">
                                    <span aria-hidden="true">@(companyPage.Company.Scale.HasValue ? "✓" : "○")</span> Company size selected
                                </li>
                                <li class="@CheckClass(!string.IsNullOrWhiteSpace(companyPage.Company.Description))">
                                    <span aria-hidden="true">@(!string.IsNullOrWhiteSpace(companyPage.Company.Description) ? "✓" : "○")</span> Company description written
                                </li>
                            </ul>
                            @if (companyPage.IsOwner && ProfileFieldsComplete < 5)
                            {
                                <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" @onclick='() => ShowTab("profile")'>Complete profile</button>
                            }
                        </div>

                        <p class="ec-footnote">Only approved companies can publish postings and open the applicant workspace. Contact HotJob support if the status looks wrong.</p>
                    </section>
                }
                else
                {
                    <section class="workspace-card" role="region" aria-label="Activity log">
                        <div class="workspace-section-head">
                            <div>
                                <h2>Activity log</h2>
                                <p class="workspace-sub">A record of hiring actions taken by your team.</p>
                            </div>
                        </div>
                        @* ponytail: no audit model exists; show an honest empty state instead of demo entries. *@
                        <div class="workspace-empty">
                            <span class="workspace-empty-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                            </span>
                            <h3>Activity history isn’t connected yet</h3>
                            <p>Member approvals, posting changes and application actions still follow the same permissions, but they aren’t recorded in a viewable log. This page will list them once audit storage ships.</p>
                            <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" @onclick='() => ShowTab("team")'>Review team access</button>
                        </div>
                    </section>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string activeTab = "team";
    private bool editing;
    private bool isLoading = true;
    private bool hasLoadedOnce;
    private bool isActing;
    private bool noticeIsError;
    private bool savedIsError;
    private string? loadError;
    private string? notice;
    private string? savedMessage;
    private string companyName = string.Empty;
    private CompanyPageResponse? companyPage;
    private readonly UpdateCompanyRequest companyForm = new();

    private IReadOnlyList<CompanyMemberDto> PendingMembers =>
        companyPage?.Members.Where(m => m.MembershipStatus == MembershipStatus.Pending).ToList() ?? [];

    private IReadOnlyList<CompanyMemberDto> ActiveMembers =>
        companyPage?.Members.Where(m => m.MembershipStatus == MembershipStatus.Active).ToList() ?? [];

    private int ProfileFieldsComplete =>
        companyPage is null
            ? 0
            : new[]
            {
                !string.IsNullOrWhiteSpace(companyPage.Company.Website),
                !string.IsNullOrWhiteSpace(companyPage.Company.Industry),
                !string.IsNullOrWhiteSpace(companyPage.Company.Location),
                companyPage.Company.Scale.HasValue,
                !string.IsNullOrWhiteSpace(companyPage.Company.Description)
            }.Count(done => done);

    private int ProfilePercent => ProfileFieldsComplete * 20;

    private string StatusExplanation => companyPage?.Company.Status switch
    {
        CompanyStatus.Approved => "Verified by HotJob operations. Your team can publish postings and work with applicants.",
        CompanyStatus.Rejected => "Verification was declined. Update the profile, then contact HotJob support to request another review.",
        _ => "Under review by the HotJob operations team. Keep the company profile accurate while you wait."
    };

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        if (AuthSession.IsAuthenticated)
        {
            await LoadAsync();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;

    private static string StatusLabel(CompanyStatus status) => status switch
    {
        CompanyStatus.Approved => "Approved",
        CompanyStatus.Rejected => "Rejected",
        _ => "Pending review"
    };

    private static string StatusClass(CompanyStatus status) => status switch
    {
        CompanyStatus.Approved => "is-approved",
        CompanyStatus.Rejected => "is-rejected",
        _ => "is-pending"
    };

    private static string CheckClass(bool done) => done ? "is-done" : string.Empty;

    private static string ScaleLabel(CompanyScale? scale) => scale switch
    {
        CompanyScale.LessThan10 => "1-9 employees",
        CompanyScale.From10To49 => "10-49 employees",
        CompanyScale.From50To199 => "50-199 employees",
        CompanyScale.From200To499 => "200-499 employees",
        CompanyScale.MoreThan500 => "500+ employees",
        _ => "Not added"
    };

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
        };
    }

    private static string? SafeWebsite(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? uri.ToString()
            : null;

    private void ShowTab(string tab)
    {
        if (tab != activeTab && activeTab == "profile")
        {
            CancelEdit();
        }
        activeTab = tab;
    }

    private void BeginEdit()
    {
        savedMessage = null;
        savedIsError = false;
        editing = true;
    }

    private void CancelEdit()
    {
        editing = false;
        savedMessage = null;
        savedIsError = false;
        ResetForm();
    }

    private void ResetForm()
    {
        companyForm.Website = companyPage?.Company.Website;
        companyForm.Industry = companyPage?.Company.Industry;
        companyForm.Location = companyPage?.Company.Location;
        companyForm.Scale = companyPage?.Company.Scale;
        companyForm.Description = companyPage?.Company.Description;
    }

    private async Task<string?> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub");
    }

    private async Task LoadAsync()
    {
        if (isLoading && hasLoadedOnce)
        {
            return;
        }
        isLoading = true;
        hasLoadedOnce = true;
        loadError = null;
        try
        {
            var result = await CompanyService.GetPageAsync(await GetUserIdAsync());
            if (!result.Success || result.Data is null)
            {
                loadError = result.Errors.FirstOrDefault() ?? "We could not load your company.";
                return;
            }
            companyPage = result.Data;
            companyName = companyPage.Company.CompanyName;
            ResetForm();
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        savedMessage = null;
        savedIsError = false;
        isActing = true;
        try
        {
            var result = await CompanyService.UpdateAsync(await GetUserIdAsync(), companyForm);
            if (result.Success && result.Data is not null)
            {
                editing = false;
                savedMessage = "Company profile saved.";
                await LoadAsync();
            }
            else
            {
                savedMessage = result.Errors.FirstOrDefault() ?? "Could not save this company.";
                savedIsError = true;
            }
        }
        finally
        {
            isActing = false;
        }
    }

    private async Task ApproveAsync(int memberId, string fullName)
    {
        notice = null;
        noticeIsError = false;
        isActing = true;
        try
        {
            var result = await CompanyService.ApproveMemberAsync(await GetUserIdAsync(), memberId);
            notice = result.Success ? $"Approved {fullName}. They can now use the employer workspace." : result.Errors.FirstOrDefault() ?? "Could not approve this member.";
            noticeIsError = !result.Success;
            if (result.Success) await LoadAsync();
        }
        finally
        {
            isActing = false;
        }
    }

    private async Task RejectAsync(int memberId, string fullName)
    {
        notice = null;
        noticeIsError = false;
        isActing = true;
        try
        {
            var result = await CompanyService.RejectMemberAsync(await GetUserIdAsync(), memberId);
            notice = result.Success ? $"Rejected {fullName}." : result.Errors.FirstOrDefault() ?? "Could not reject this member.";
            noticeIsError = !result.Success;
            if (result.Success) await LoadAsync();
        }
        finally
        {
            isActing = false;
        }
    }
}
