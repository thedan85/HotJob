@page "/admin/jobs"
@rendermode InteractiveServer
@using System.Security.Claims
@using hotjob.DTOs.Admin
@using hotjob.DTOs.Common
@using hotjob.Models.Job
@using hotjob.Services.Admin
@using hotjob.Services.Common
@inject IJobAdminService JobAdminService
@inject IAdminService AdminService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Admin jobs | HotJob</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="workspace admin-page">
            <section class="workspace-header">
                <div class="workspace-header-copy">
                    <p class="workspace-eyebrow">Administration</p>
                    <h1>Job posting management</h1>
                    <p class="workspace-lede">Approve or reject postings waiting for review. Removing a posting closes it for good, keeps its applications on record and tells the employer why.</p>
                </div>
            </section>

            <section class="workspace-toolbar" aria-label="Filter job postings">
                <label class="workspace-field">
                    <span>Status</span>
                    <select @bind="statusFilter" @bind:after="ApplyFiltersAsync">
                        <option value="">All statuses</option>
                        @foreach (var option in Enum.GetValues<JobStatus>())
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label class="workspace-field">
                    <span>Featured</span>
                    <select @bind="featuredFilter" @bind:after="ApplyFiltersAsync">
                        <option value="">Any</option>
                        <option value="yes">Featured now</option>
                        <option value="no">Not featured</option>
                    </select>
                </label>
                <label class="workspace-field">
                    <span>Removed by admin</span>
                    <select @bind="removedFilter" @bind:after="ApplyFiltersAsync">
                        <option value="">Any</option>
                        <option value="yes">Removed</option>
                        <option value="no">Not removed</option>
                    </select>
                </label>
                <label class="workspace-field">
                    <span>Search</span>
                    <input type="search" @bind="searchTerm" @bind:after="ApplyFiltersAsync" placeholder="Title or company" />
                </label>
            </section>
            @if (CompanyId is not null)
            {
                <p class="workspace-sub">Showing one company's postings only. <a href="/admin/jobs">Show all companies</a></p>
            }

            @if (actionMessage is not null)
            {
                <div class="@(actionSucceeded ? "workspace-notice" : "workspace-alert")" role="@(actionSucceeded ? "status" : "alert")">@actionMessage</div>
            }

            @if (isLoading)
            {
                <section class="workspace-card" aria-busy="true" aria-label="Loading job postings">
                    <p class="workspace-sub">Loading job postings…</p>
                </section>
            }
            else if (errorMessage is not null)
            {
                <div class="workspace-alert" role="alert">@errorMessage</div>
            }
            else if (paged is not null)
            {
                <section class="workspace-card" aria-labelledby="admin-jobs-heading">
                    <div class="workspace-section-head">
                        <div>
                            <h2 id="admin-jobs-heading">@(statusFilter is null ? "All job postings" : $"{statusFilter} job postings")</h2>
                            <p class="workspace-sub">@paged.TotalCount total · page @paged.Page of @Math.Max(paged.TotalPages, 1)</p>
                        </div>
                    </div>
                    <div style="overflow-x:auto">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Company</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th>Applications</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in paged.Items)
                                {
                                    <tr>
                                        <td>
                                            @if (job.Status == nameof(JobStatus.Published) && job.ModeratedAt is null)
                                            {
                                                <a href="/jobs/@job.Id" target="_blank" rel="noopener">@job.Title</a>
                                            }
                                            else
                                            {
                                                @job.Title
                                            }
                                            @if (job.FeaturedUntil is { } featuredUntil && featuredUntil > DateTime.UtcNow)
                                            {
                                                <span class="workspace-badge is-published">Featured</span>
                                            }
                                        </td>
                                        <td><a href="/admin/companies/@job.CompanyProfileId">@job.CompanyName</a></td>
                                        <td>@(string.IsNullOrWhiteSpace(job.City) ? "-" : job.City)</td>
                                        <td>
                                            @if (job.ModeratedAt is not null)
                                            {
                                                <span class="workspace-badge is-rejected" title="@job.ModerationReason">Removed</span>
                                            }
                                            else
                                            {
                                                <span class="workspace-badge @StatusClass(job.Status)">@job.Status</span>
                                            }
                                        </td>
                                        <td>@job.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td>@job.ApplicationCount</td>
                                        <td>
                                            @if (job.ModeratedAt is not null)
                                            {
                                                <span class="workspace-sub">Removed @job.ModeratedAt.Value.ToString("dd MMM yyyy")</span>
                                            }
                                            else
                                            {
                                                <div class="workspace-toolbar-actions">
                                                    @if (job.Status == nameof(JobStatus.PendingApproval))
                                                    {
                                                        <button class="workspace-btn workspace-btn-primary workspace-btn-small" type="button" disabled="@busy" @onclick="() => ApproveJobAsync(job.Id)">Approve</button>
                                                        <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button" disabled="@busy" @onclick="() => BeginReject(job.Id)">Reject</button>
                                                    }
                                                    <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button" disabled="@busy" @onclick="() => BeginRemove(job.Id)">Remove</button>
                                                    @if (job.ApplicationCount == 0)
                                                    {
                                                        <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button" disabled="@busy" @onclick="() => DeleteJobAsync(job.Id)">
                                                            @(pendingDeleteId == job.Id ? "Confirm delete?" : "Delete")
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                    @if (job.ModeratedAt is not null && !string.IsNullOrWhiteSpace(job.ModerationReason))
                                    {
                                        <tr>
                                            <td colspan="7"><span class="workspace-sub">Removal reason: @job.ModerationReason</span></td>
                                        </tr>
                                    }
                                    @if (removingId == job.Id)
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <div class="admin-reject-form">
                                                    <label class="workspace-field">
                                                        <span>Removal reason (required, shown to the employer)</span>
                                                        <textarea @bind="removalReason" maxlength="500" rows="2"
                                                                  placeholder="Explain which rule this posting breaks."></textarea>
                                                    </label>
                                                    <p class="workspace-sub">The posting is closed permanently and its @job.ApplicationCount application(s) stay on record; open ones are rejected and the candidates notified.</p>
                                                    @if (removeError is not null)
                                                    {
                                                        <div class="workspace-alert" role="alert">@removeError</div>
                                                    }
                                                    <div class="workspace-toolbar-actions">
                                                        <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button"
                                                                disabled="@busy" @onclick="() => RemoveJobAsync(job.Id)">
                                                            @(busy ? "Removing…" : "Confirm removal")
                                                        </button>
                                                        <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button"
                                                                disabled="@busy" @onclick="CancelRemove">Cancel</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @if (rejectingId == job.Id)
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <div class="admin-reject-form">
                                                    <label class="workspace-field">
                                                        <span>Rejection reason (required)</span>
                                                        <textarea @bind="rejectionReason" maxlength="500" rows="2"
                                                                  placeholder="Tell the employer what to change before resubmitting."></textarea>
                                                    </label>
                                                    @if (rejectError is not null)
                                                    {
                                                        <div class="workspace-alert" role="alert">@rejectError</div>
                                                    }
                                                    <div class="workspace-toolbar-actions">
                                                        <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button"
                                                                disabled="@busy" @onclick="() => RejectJobAsync(job.Id)">
                                                            @(busy ? "Rejecting…" : "Confirm rejection")
                                                        </button>
                                                        <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button"
                                                                disabled="@busy" @onclick="CancelReject">Cancel</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (paged.TotalPages > 1)
                    {
                        <nav class="jobs-pager" aria-label="Job posting pages">
                            <button type="button" class="page-btn" disabled="@(paged.Page <= 1)"
                                    @onclick="() => LoadAsync(paged.Page - 1)">← Prev</button>
                            <span class="page-info">Page @paged.Page of @paged.TotalPages · @paged.TotalCount postings</span>
                            <button type="button" class="page-btn" disabled="@(paged.Page >= paged.TotalPages)"
                                    @onclick="() => LoadAsync(paged.Page + 1)">Next →</button>
                        </nav>
                    }
                </section>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const int PageSize = 20;

    private PagedResponse<JobListItemDto>? paged;
    private int page = 1;
    private JobStatus? statusFilter;
    private string? searchTerm;
    private string featuredFilter = string.Empty;
    private string removedFilter = string.Empty;

    /// <summary>Optional company filter, e.g. /admin/jobs?companyId=3 from the company page.</summary>
    [SupplyParameterFromQuery(Name = "companyId")]
    public int? CompanyId { get; set; }
    private bool isLoading = true;
    private bool busy;
    private string? errorMessage;
    private string? actionMessage;
    private bool actionSucceeded;
    private int? rejectingId;
    private string? rejectionReason;
    private string? rejectError;
    private int? pendingDeleteId;
    private int? removingId;
    private string? removalReason;
    private string? removeError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task ApplyFiltersAsync() => LoadAsync(1);

    private async Task LoadAsync(int? requestedPage = null)
    {
        page = requestedPage ?? page;
        try
        {
            var result = await JobAdminService.ListAsync(new AdminJobQuery
            {
                Page = page,
                PageSize = PageSize,
                Search = searchTerm,
                Status = statusFilter,
                CompanyId = CompanyId,
                IsFeatured = ToFlag(featuredFilter),
                IsModerated = ToFlag(removedFilter)
            });
            if (!result.Success || result.Data is null)
            {
                errorMessage = string.Join("; ", result.Errors);
                return;
            }

            errorMessage = null;
            paged = result.Data;
            if (paged.TotalCount > 0 && page > paged.TotalPages)
            {
                await LoadAsync(paged.TotalPages);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApproveJobAsync(int jobId)
    {
        var adminId = await GetAdminIdAsync();
        await RunAsync(
            () => adminId is null ? Task.FromResult(NotSignedIn()) : JobAdminService.ApproveAsync(jobId, adminId),
            "Job approved. The employer can now publish it.");
    }

    private void BeginRemove(int jobId)
    {
        CancelReject();
        pendingDeleteId = null;
        removingId = jobId;
        removalReason = null;
        removeError = null;
    }

    private void CancelRemove()
    {
        removingId = null;
        removalReason = null;
        removeError = null;
    }

    private async Task RemoveJobAsync(int jobId)
    {
        var reason = removalReason?.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            removeError = "Enter a removal reason.";
            return;
        }

        var adminId = await GetAdminIdAsync();
        if (adminId is null)
        {
            removeError = string.Join("; ", NotSignedIn().Errors);
            return;
        }

        var closed = 0;
        var failure = await RunAsync(
            async () =>
            {
                var result = await JobAdminService.RemoveAsync(jobId, adminId, reason);
                closed = result.Data;
                return result;
            },
            () => closed == 0
                ? "Job removed. The employer has been notified."
                : $"Job removed. {closed} open application(s) were closed and the candidates notified.");
        if (failure is null)
        {
            CancelRemove();
        }
        else
        {
            removeError = failure;
        }
    }

    private void BeginReject(int jobId)
    {
        CancelRemove();
        rejectingId = jobId;
        rejectionReason = null;
        rejectError = null;
    }

    private void CancelReject()
    {
        rejectingId = null;
        rejectionReason = null;
        rejectError = null;
    }

    private async Task RejectJobAsync(int jobId)
    {
        var reason = rejectionReason?.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            rejectError = "Enter a rejection reason.";
            return;
        }

        var adminId = await GetAdminIdAsync();
        var failure = await RunAsync(
            () => adminId is null ? Task.FromResult(NotSignedIn()) : JobAdminService.RejectAsync(jobId, adminId, reason),
            "Job rejected.");
        if (failure is null)
        {
            CancelReject();
        }
        else
        {
            rejectError = failure;
        }
    }

    /// <summary>Hard delete (kept from the original admin page) — asks for a second click first.</summary>
    private async Task DeleteJobAsync(int jobId)
    {
        if (pendingDeleteId != jobId)
        {
            pendingDeleteId = jobId;
            return;
        }

        pendingDeleteId = null;
        await RunAsync(async () => await AdminService.DeleteJobAsync(jobId), "Job deleted.");
    }

    /// <summary>Runs an admin write, then reloads. Returns the error, if any.</summary>
    private Task<string?> RunAsync(Func<Task<ServiceResult>> write, string successMessage) =>
        RunAsync(write, () => successMessage);

    private async Task<string?> RunAsync(Func<Task<ServiceResult>> write, Func<string> successMessage)
    {
        busy = true;
        actionMessage = null;
        actionSucceeded = false;
        try
        {
            var result = await write();
            if (!result.Success)
            {
                return actionMessage = string.Join("; ", result.Errors);
            }

            actionSucceeded = true;
            actionMessage = successMessage();
            await LoadAsync();
            return null;
        }
        catch (Exception ex)
        {
            return actionMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static bool? ToFlag(string value) => value switch
    {
        "yes" => true,
        "no" => false,
        _ => null
    };

    private static ServiceResult NotSignedIn() =>
        ServiceResult.Fail(ServiceErrorType.Unauthorized, "Sign in as an administrator to review job postings.");

    private async Task<string?> GetAdminIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub");
    }

    private static string StatusClass(string status) => status switch
    {
        nameof(JobStatus.Published) => "is-published",
        nameof(JobStatus.Approved) => "is-approved",
        nameof(JobStatus.PendingApproval) => "is-pending",
        nameof(JobStatus.Rejected) => "is-rejected",
        nameof(JobStatus.Draft) => "is-draft",
        nameof(JobStatus.Closed) => "is-closed",
        nameof(JobStatus.Expired) => "is-expired",
        _ => "is-muted"
    };
}
