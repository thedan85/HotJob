@page "/admin/companies"
@rendermode InteractiveServer
@using System.Security.Claims
@using hotjob.DTOs.Admin
@using hotjob.DTOs.Common
@using hotjob.Models.Users
@using hotjob.Services.Admin
@using hotjob.Services.Common
@inject ICompanyAdminService CompanyAdminService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Admin companies | HotJob</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="workspace admin-page">
            <section class="workspace-header">
                <div class="workspace-header-copy">
                    <p class="workspace-eyebrow">Administration</p>
                    <h1>Company management</h1>
                    <p class="workspace-lede">Review pending companies, approve or reject them with a reason, and suspend companies that break the rules. The company's active members are notified when it is approved or rejected.</p>
                </div>
            </section>

            <section class="workspace-toolbar" aria-label="Filter companies">
                <label class="workspace-field">
                    <span>Status</span>
                    <select @bind="statusFilter" @bind:after="ApplyFiltersAsync">
                        <option value="">All statuses</option>
                        @foreach (var option in Enum.GetValues<CompanyStatus>())
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label class="workspace-field">
                    <span>Search</span>
                    <input type="search" @bind="searchTerm" @bind:after="ApplyFiltersAsync" placeholder="Name, industry or location" />
                </label>
            </section>

            @if (actionMessage is not null)
            {
                <div class="@(actionSucceeded ? "workspace-notice" : "workspace-alert")" role="@(actionSucceeded ? "status" : "alert")">@actionMessage</div>
            }

            @if (isLoading)
            {
                <section class="workspace-card" aria-busy="true" aria-label="Loading companies">
                    <p class="workspace-sub">Loading companies…</p>
                </section>
            }
            else if (errorMessage is not null)
            {
                <div class="workspace-alert" role="alert">@errorMessage</div>
            }
            else if (paged is not null)
            {
                <section class="workspace-card" aria-labelledby="admin-companies-heading">
                    <div class="workspace-section-head">
                        <div>
                            <h2 id="admin-companies-heading">@(statusFilter is null ? "All companies" : $"{statusFilter} companies")</h2>
                            <p class="workspace-sub">@paged.TotalCount total · page @paged.Page of @Math.Max(paged.TotalPages, 1)</p>
                        </div>
                    </div>
                    <div style="overflow-x:auto">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Company</th>
                                    <th>Status</th>
                                    <th>Industry</th>
                                    <th>Location</th>
                                    <th>Verified</th>
                                    <th>Members</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var company in paged.Items)
                                {
                                    <tr>
                                        <td><a href="/admin/companies/@company.Id">@company.CompanyName</a></td>
                                        <td>
                                            <span class="workspace-badge is-@(company.Status.ToLowerInvariant())">@company.Status</span>
                                            @if (!company.IsActive)
                                            {
                                                <span class="workspace-badge is-muted">Deactivated</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(company.Industry) ? "-" : company.Industry)</td>
                                        <td>@(string.IsNullOrWhiteSpace(company.Location) ? "-" : company.Location)</td>
                                        <td>@(company.VerifiedAt is null ? "Unverified" : company.VerifiedAt.Value.ToString("dd MMM yyyy"))</td>
                                        <td>@company.EmployerCount</td>
                                        <td>
                                            <div class="workspace-toolbar-actions">
                                                @if (company.Status != nameof(CompanyStatus.Approved))
                                                {
                                                    <button class="workspace-btn workspace-btn-primary workspace-btn-small" type="button" disabled="@busy" @onclick="() => ApproveCompanyAsync(company.Id)">Approve</button>
                                                }
                                                @if (company.Status != nameof(CompanyStatus.Rejected))
                                                {
                                                    <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button" disabled="@busy" @onclick="() => BeginReject(company.Id)">Reject</button>
                                                }
                                                @if (company.IsActive)
                                                {
                                                    <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button" disabled="@busy" @onclick="() => DeactivateCompanyAsync(company.Id)">Deactivate</button>
                                                }
                                                else
                                                {
                                                    <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button" disabled="@busy" @onclick="() => ReactivateCompanyAsync(company.Id)">Reactivate</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    @if (rejectingId == company.Id)
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <div class="admin-reject-form">
                                                    <label class="workspace-field">
                                                        <span>Rejection reason (required)</span>
                                                        <textarea @bind="rejectionReason" maxlength="500" rows="2"
                                                                  placeholder="Tell the employer what to fix before resubmitting."></textarea>
                                                    </label>
                                                    @if (rejectError is not null)
                                                    {
                                                        <div class="workspace-alert" role="alert">@rejectError</div>
                                                    }
                                                    <div class="workspace-toolbar-actions">
                                                        <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button"
                                                                disabled="@busy" @onclick="() => RejectCompanyAsync(company.Id)">
                                                            @(busy ? "Rejecting…" : "Confirm rejection")
                                                        </button>
                                                        <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button"
                                                                disabled="@busy" @onclick="CancelReject">Cancel</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (paged.TotalPages > 1)
                    {
                        <nav class="jobs-pager" aria-label="Company pages">
                            <button type="button" class="page-btn" disabled="@(paged.Page <= 1)"
                                    @onclick="() => LoadAsync(paged.Page - 1)">← Prev</button>
                            <span class="page-info">Page @paged.Page of @paged.TotalPages · @paged.TotalCount companies</span>
                            <button type="button" class="page-btn" disabled="@(paged.Page >= paged.TotalPages)"
                                    @onclick="() => LoadAsync(paged.Page + 1)">Next →</button>
                        </nav>
                    }
                </section>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const int PageSize = 20;

    private PagedResponse<CompanyListItemDto>? paged;
    private int page = 1;
    private CompanyStatus? statusFilter;
    private string? searchTerm;
    private bool isLoading = true;
    private bool busy;
    private string? errorMessage;
    private string? actionMessage;
    private bool actionSucceeded;
    private int? rejectingId;
    private string? rejectionReason;
    private string? rejectError;

    /// <summary>Optional initial status filter, e.g. /admin/companies?status=Pending from the dashboard.</summary>
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Enum.TryParse<CompanyStatus>(StatusQuery, ignoreCase: true, out var initial))
        {
            statusFilter = initial;
        }

        await LoadAsync();
    }

    private Task ApplyFiltersAsync() => LoadAsync(1);

    private async Task LoadAsync(int? requestedPage = null)
    {
        page = requestedPage ?? page;
        try
        {
            var result = await CompanyAdminService.ListAsync(page, PageSize, searchTerm, statusFilter);
            if (!result.Success || result.Data is null)
            {
                errorMessage = string.Join("; ", result.Errors);
                return;
            }

            errorMessage = null;
            paged = result.Data;
            if (paged.TotalCount > 0 && page > paged.TotalPages)
            {
                await LoadAsync(paged.TotalPages);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ApproveCompanyAsync(int companyId) =>
        RunAsync(adminId => CompanyAdminService.ApproveAsync(companyId, adminId), "Company approved.");

    private Task DeactivateCompanyAsync(int companyId) =>
        RunAsync(adminId => CompanyAdminService.DeactivateAsync(companyId, adminId), "Company deactivated. Its employers can no longer manage jobs.");

    private Task ReactivateCompanyAsync(int companyId) =>
        RunAsync(adminId => CompanyAdminService.ReactivateAsync(companyId, adminId), "Company reactivated.");

    private void BeginReject(int companyId)
    {
        rejectingId = companyId;
        rejectionReason = null;
        rejectError = null;
    }

    private void CancelReject()
    {
        rejectingId = null;
        rejectionReason = null;
        rejectError = null;
    }

    private async Task RejectCompanyAsync(int companyId)
    {
        var reason = rejectionReason?.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            rejectError = "Enter a rejection reason.";
            return;
        }

        var failure = await RunAsync(adminId => CompanyAdminService.RejectAsync(companyId, adminId, reason), "Company rejected.");
        if (failure is null)
        {
            CancelReject();
        }
        else
        {
            rejectError = failure;
        }
    }

    /// <summary>Runs an admin write as the signed-in admin, then reloads. Returns the error, if any.</summary>
    private async Task<string?> RunAsync(Func<string, Task<ServiceResult>> write, string successMessage)
    {
        busy = true;
        actionMessage = null;
        actionSucceeded = false;
        try
        {
            var adminId = await GetAdminIdAsync();
            if (adminId is null)
            {
                return actionMessage = "Sign in as an administrator to manage companies.";
            }

            var result = await write(adminId);
            if (!result.Success)
            {
                return actionMessage = string.Join("; ", result.Errors);
            }

            actionSucceeded = true;
            actionMessage = successMessage;
            await LoadAsync();
            return null;
        }
        catch (Exception ex)
        {
            return actionMessage = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<string?> GetAdminIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub");
    }
}
