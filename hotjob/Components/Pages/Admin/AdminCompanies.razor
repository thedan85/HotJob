@page "/admin/companies"
@rendermode InteractiveServer
@using System.Security.Claims
@using hotjob.DTOs.Admin
@using hotjob.DTOs.Job
@using hotjob.Models.Users
@using hotjob.Services.Admin
@inject IAdminService AdminService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Admin companies | HotJob</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="workspace admin-page">
            <section class="workspace-header">
                <div class="workspace-header-copy">
                    <p class="workspace-eyebrow">Administration</p>
                    <h1>Company management</h1>
                    <p class="workspace-lede">Review pending companies, approve them, or reject them with a reason.</p>
                </div>
            </section>

            @if (isLoading)
            {
                <section class="workspace-card" aria-busy="true" aria-label="Loading companies">
                    <p class="workspace-sub">Loading companies…</p>
                </section>
            }
            else if (errorMessage is not null)
            {
                <div class="workspace-alert" role="alert">@errorMessage</div>
            }
            else if (paged is not null)
            {
                <section class="workspace-card" aria-labelledby="admin-companies-heading">
                    <div class="workspace-section-head">
                        <div>
                            <h2 id="admin-companies-heading">All companies</h2>
                            <p class="workspace-sub">@paged.TotalCount total · page @paged.Page of @Math.Max(paged.TotalPages, 1)</p>
                        </div>
                    </div>
                    <div style="overflow-x:auto">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Company</th>
                                    <th>Status</th>
                                    <th>Industry</th>
                                    <th>Location</th>
                                    <th>Verified</th>
                                    <th>Members</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var company in paged.Items)
                                {
                                    <tr>
                                        <td>@company.CompanyName</td>
                                        <td>
                                            <span class="workspace-badge is-@(StatusClass(company.Status))">@company.Status</span>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(company.Industry) ? "-" : company.Industry)</td>
                                        <td>@(string.IsNullOrWhiteSpace(company.Location) ? "-" : company.Location)</td>
                                        <td>@(company.VerifiedAt is null ? "Unverified" : company.VerifiedAt.Value.ToString("dd MMM yyyy"))</td>
                                        <td>@company.EmployerCount</td>
                                        <td>
                                            <div class="workspace-toolbar-actions">
                                                @if (company.Status != CompanyStatus.Approved)
                                                {
                                                    <button class="workspace-btn workspace-btn-primary workspace-btn-small" type="button" @onclick="() => ApproveCompany(company.Id)">Approve</button>
                                                }
                                                @if (company.Status != CompanyStatus.Rejected)
                                                {
                                                    <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button" @onclick="() => BeginReject(company.Id)">Reject</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    @if (rejectingId == company.Id)
                                    {
                                        <tr>
                                            <td colspan="7">
                                                <div class="admin-reject-form">
                                                    <label class="workspace-field">
                                                        <span>Rejection reason (required)</span>
                                                        <textarea @bind="rejectionReason" maxlength="1000" rows="2"
                                                                  placeholder="Tell the employer what to fix before resubmitting."></textarea>
                                                    </label>
                                                    @if (rejectError is not null)
                                                    {
                                                        <div class="workspace-alert" role="alert">@rejectError</div>
                                                    }
                                                    <div class="workspace-toolbar-actions">
                                                        <button class="workspace-btn workspace-btn-danger workspace-btn-small" type="button"
                                                                disabled="@rejectBusy" @onclick="() => RejectCompanyAsync(company.Id)">
                                                            @(rejectBusy ? "Rejecting…" : "Confirm rejection")
                                                        </button>
                                                        <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button"
                                                                disabled="@rejectBusy" @onclick="CancelReject">Cancel</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (paged.TotalPages > 1)
                    {
                        <nav class="jobs-pager" aria-label="Company pages">
                            <button type="button" class="page-btn" disabled="@(paged.Page <= 1)"
                                    @onclick="() => LoadAsync(paged.Page - 1)">← Prev</button>
                            <span class="page-info">Page @paged.Page of @paged.TotalPages · @paged.TotalCount companies</span>
                            <button type="button" class="page-btn" disabled="@(paged.Page >= paged.TotalPages)"
                                    @onclick="() => LoadAsync(paged.Page + 1)">Next →</button>
                        </nav>
                    }
                </section>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const int PageSize = 20;

    private PagedResponse<AdminCompanyListItemDto>? paged;
    private int page = 1;
    private bool isLoading = true;
    private string? errorMessage;
    private int? rejectingId;
    private string? rejectionReason;
    private string? rejectError;
    private bool rejectBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int? requestedPage = null)
    {
        page = requestedPage ?? page;
        try
        {
            var result = await AdminService.GetCompaniesAsync(page, PageSize);
            if (!result.Success || result.Data is null)
            {
                errorMessage = string.Join("; ", result.Errors);
                return;
            }

            paged = result.Data;
            if (paged.TotalCount > 0 && page > paged.TotalPages)
            {
                await LoadAsync(paged.TotalPages);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApproveCompany(int companyId)
    {
        try
        {
            var result = await AdminService.UpdateCompanyStatusAsync(
                companyId, CompanyStatus.Approved, null, await GetUserIdAsync());
            if (!result.Success)
            {
                errorMessage = string.Join("; ", result.Errors);
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void BeginReject(int companyId)
    {
        rejectingId = companyId;
        rejectionReason = null;
        rejectError = null;
    }

    private void CancelReject()
    {
        rejectingId = null;
        rejectionReason = null;
        rejectError = null;
    }

    private async Task RejectCompanyAsync(int companyId)
    {
        var reason = rejectionReason?.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            rejectError = "Enter a rejection reason.";
            return;
        }

        rejectBusy = true;
        rejectError = null;
        try
        {
            var result = await AdminService.UpdateCompanyStatusAsync(
                companyId, CompanyStatus.Rejected, reason, await GetUserIdAsync());
            if (!result.Success)
            {
                rejectError = string.Join("; ", result.Errors);
                return;
            }

            CancelReject();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            rejectError = ex.Message;
        }
        finally
        {
            rejectBusy = false;
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub");
    }

    private static string StatusClass(CompanyStatus status) => status switch
    {
        CompanyStatus.Pending => "warning",
        CompanyStatus.Approved => "success",
        CompanyStatus.Rejected => "danger",
        _ => "neutral"
    };
}
