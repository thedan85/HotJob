@page "/my-applications"
@implements IDisposable
@rendermode InteractiveServer
@using System.Security.Claims
@using hotjob.DTOs.Candidate
@using hotjob.Models.Application
@using hotjob.Services.Candidate
@using hotjob.Services.Common
@inject ICandidateService CandidateService
@inject NotificationFeed NotificationFeed
@inject CircuitDbGate CircuitDbGate
@inject IApplicationService ApplicationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthSession AuthSession

<PageTitle>My applications | HotJob</PageTitle>

<AuthorizeView Roles="Candidate">
    <Authorized Context="auth">
        <div class="ma-page workspace">
            <section class="workspace-header">
                <div class="workspace-header-copy">
                    <p class="workspace-eyebrow">Candidate workspace</p>
                    <h1>Your applications</h1>
                    <p class="workspace-lede">Track every role you applied to, follow each status change, and read the messages employers sent you.</p>
                </div>
                <div class="workspace-actions">
                    <a class="workspace-btn workspace-btn-primary" href="/it-jobs">Browse jobs</a>
                </div>
            </section>

            @if (isLoading)
            {
                <section class="workspace-card" aria-busy="true" aria-label="Loading your applications">
                    <div class="workspace-metrics">
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                        <div class="workspace-skeleton" style="height:110px"></div>
                    </div>
                    <div class="ma-skeleton-layout">
                        <div class="workspace-skeleton" style="height:300px"></div>
                        <div class="workspace-skeleton" style="height:300px"></div>
                    </div>
                    <p class="visually-hidden" role="status">Loading your applications…</p>
                </section>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="workspace-alert" role="alert">@loadError</div>
            }
            else
            {
                <section class="workspace-metrics" aria-label="Application overview">
                    <div class="workspace-stat">
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V6a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" /><path d="M8 12h8M8 16h5" /></svg>
                        </span>
                        <span class="workspace-stat-label">Applications</span>
                        <span class="workspace-stat-value">@TotalApplications</span>
                        <span class="workspace-stat-hint">Jobs you applied to</span>
                    </div>
                    <div class="workspace-stat">
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                        </span>
                        <span class="workspace-stat-label">In progress</span>
                        <span class="workspace-stat-value">@InProgressCount</span>
                        <span class="workspace-stat-hint">Still being reviewed</span>
                    </div>
                    <div class="workspace-stat">
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6" /></svg>
                        </span>
                        <span class="workspace-stat-label">Offers</span>
                        <span class="workspace-stat-value">@OfferCount</span>
                        <span class="workspace-stat-hint">Offers received</span>
                    </div>
                    <div class="workspace-stat">
                        <span class="workspace-stat-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v11H8l-4 4V6z" /><path d="M8 10h8M8 13h5" /></svg>
                        </span>
                        <span class="workspace-stat-label">Unread messages</span>
                        <span class="workspace-stat-value">@unreadCount</span>
                        <span class="workspace-stat-hint">From employers</span>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(actionMessage))
                {
                    <div class="workspace-notice" role="status" aria-live="polite">@actionMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(actionError))
                {
                    <div class="workspace-alert" role="alert" aria-live="assertive">@actionError</div>
                }

                @if (TotalApplications > 0)
                {
                    <section class="workspace-toolbar" aria-label="Filter applications">
                        <label class="workspace-field workspace-field-grow">
                            <span>Search</span>
                            <input type="search" value="@query.Search" @oninput="OnSearchInput" placeholder="Job title or company" />
                        </label>
                        <label class="workspace-field">
                            <span>Status</span>
                            <select @bind="query.StatusGroup" @bind:after="ApplyFiltersAsync">
                                <option value="">All applications</option>
                                <option value="active">In progress</option>
                                <option value="offers">Offers</option>
                                <option value="closed">Rejected or withdrawn</option>
                            </select>
                        </label>
                        @if (HasFilters)
                        {
                            <div class="workspace-toolbar-actions">
                                <button class="workspace-btn workspace-btn-ghost" type="button" @onclick="ClearFiltersAsync">Clear</button>
                            </div>
                        }
                    </section>
                }

                <div class="ma-layout">
                    <section class="ma-apps" aria-label="My applications" aria-busy="@isPageLoading">
                        <div class="workspace-section-head">
                            <div>
                                <h2>Applications</h2>
                                <p class="workspace-sub">@Summary@(isPageLoading ? " · Loading…" : string.Empty)</p>
                            </div>
                        </div>

                        @if (TotalApplications == 0)
                        {
                            <div class="workspace-empty">
                                <span class="workspace-empty-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V6a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" /><path d="M8 12h8M8 16h5" /></svg>
                                </span>
                                <h3>No applications yet</h3>
                                <p>When you apply to a job, its status and history appear here so you always know where you stand.</p>
                                <a class="workspace-btn workspace-btn-primary workspace-btn-small" href="/it-jobs">Browse open jobs</a>
                            </div>
                        }
                        else if (TotalCount == 0)
                        {
                            <div class="workspace-empty">
                                <h3>Nothing matches those filters</h3>
                                <p>Try a different search term or status.</p>
                                <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" @onclick="ClearFiltersAsync">Clear filters</button>
                            </div>
                        }
                        else
                        {
                            @foreach (var application in Applications)
                            {
                                <article class="ma-app">
                                    <div class="ma-app-head">
                                        <div>
                                            <h3 class="ma-app-title">@application.JobTitle</h3>
                                            <p class="ma-app-company">@application.CompanyName</p>
                                        </div>
                                        <span class="workspace-badge @StatusClass(application.Status)">@application.Status</span>
                                    </div>
                                    <div class="ma-app-meta">
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /></svg>
                                            Applied @application.AppliedAt.ToString("dd MMM yyyy")
                                        </span>
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4h8l2 2h6v14H4z" /><path d="M8 12h8M8 16h5" /></svg>
                                            CV: @application.ResumeTitle
                                        </span>
                                    </div>

                                    @if (application.Interviews.Count > 0)
                                    {
                                        <div class="ma-interviews" aria-label="Interviews">
                                            <p class="ma-interview-label">Interviews</p>
                                            <ul class="ma-interview-list">
                                                @foreach (var interview in application.Interviews.OrderByDescending(i => i.InterviewDate))
                                                {
                                                    <li class="ma-interview">
                                                        <span class="ma-interview-date">
                                                            @interview.InterviewDate.ToString("ddd dd MMM, HH:mm")
                                                        </span>
                                                        <span class="ma-interview-detail">
                                                            @(interview.InterviewType?.ToString() ?? "Interview")
                                                            @if (!string.IsNullOrWhiteSpace(interview.LocationOrLink))
                                                            {
                                                                <span> · @interview.LocationOrLink</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(interview.Notes))
                                                            {
                                                                <span> · @interview.Notes</span>
                                                            }
                                                        </span>
                                                        <span class="workspace-badge @InterviewStatusClass(interview.Status)">@interview.Status</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    @if (application.History.Count > 0 || InProgressStatuses.Contains(application.Status))
                                    {
                                        <div class="ma-app-footer">
                                            @if (application.History.Count > 0)
                                            {
                                                <details class="workspace-details ma-history">
                                                    <summary>Status history (@application.History.Count update@(application.History.Count == 1 ? string.Empty : "s"))</summary>
                                                    <div class="workspace-details-body">
                                                        <ol class="ma-timeline">
                                                            @foreach (var entry in application.History.OrderByDescending(h => h.ChangedAt))
                                                            {
                                                                <li>
                                                                    <strong>@entry.Status</strong>
                                                                    <span>@(string.IsNullOrWhiteSpace(entry.Notes) ? "No note added." : entry.Notes)</span>
                                                                    <small>@entry.ChangedAt.ToString("dd MMM yyyy, HH:mm")</small>
                                                                </li>
                                                            }
                                                        </ol>
                                                    </div>
                                                </details>
                                            }

                                            @if (InProgressStatuses.Contains(application.Status))
                                            {
                                                <div class="ma-app-actions">
                                                    @if (withdrawConfirmId == application.ApplicationId)
                                                    {
                                                        <span class="ma-withdraw-copy">Withdraw this application? This cannot be undone.</span>
                                                        <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button"
                                                                disabled="@(withdrawingId == application.ApplicationId)"
                                                                @onclick="() => WithdrawAsync(application.ApplicationId)">
                                                            @(withdrawingId == application.ApplicationId ? "Withdrawing…" : "Confirm withdraw")
                                                        </button>
                                                        <button class="workspace-btn workspace-btn-ghost workspace-btn-small" type="button"
                                                                disabled="@(withdrawingId == application.ApplicationId)"
                                                                @onclick="() => { withdrawConfirmId = null; }">
                                                            Cancel
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="workspace-btn workspace-btn-secondary workspace-btn-small ma-withdraw-trigger" type="button"
                                                                @onclick="() => { withdrawConfirmId = application.ApplicationId; }">
                                                            Withdraw application
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        }

                        @if (TotalCount > 0)
                        {
                            <div class="workspace-pagination">
                                <span>Showing @FirstShown–@LastShown of @TotalCount</span>
                                <div class="workspace-pagination-actions">
                                    <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button"
                                            disabled="@(isPageLoading || pageResult.Page <= 1)"
                                            @onclick="() => ChangePageAsync(pageResult.Page - 1)">← Previous</button>
                                    <span class="ej-page-count">Page @pageResult.Page of @TotalPages</span>
                                    <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button"
                                            disabled="@(isPageLoading || pageResult.Page >= TotalPages)"
                                            @onclick="() => ChangePageAsync(pageResult.Page + 1)">Next →</button>
                                </div>
                            </div>
                        }
                        <p class="visually-hidden" role="status">@(isPageLoading ? "Loading applications…" : string.Empty)</p>
                    </section>

                    <aside class="ma-rail" aria-label="Notifications">
                        <section class="workspace-card">
                            <div class="workspace-section-head">
                                <div>
                                    <h2>Messages</h2>
                                    <p class="workspace-sub">Updates from employers.</p>
                                </div>
                                <div class="workspace-toolbar-actions">
                                    @if (unreadCount > 0)
                                    {
                                        <span class="workspace-badge is-pending">@unreadCount unread</span>
                                    }
                                    <a class="workspace-btn workspace-btn-secondary workspace-btn-small" href="/notifications">All messages</a>
                                </div>
                            </div>

                            @if (notifications.Count == 0)
                            {
                                <div class="workspace-empty">
                                    <span class="workspace-empty-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v11H8l-4 4V6z" /><path d="M8 10h8M8 13h5" /></svg>
                                    </span>
                                    <h3>No messages yet</h3>
                                    <p>Employer updates and interview notes will show up here.</p>
                                </div>
                            }
                            else
                            {
                                <ul class="ma-notes">
                                    @foreach (var note in notifications.OrderBy(n => n.IsRead).ThenByDescending(n => n.CreatedAt))
                                    {
                                        <li class="ma-note @(note.IsRead ? string.Empty : "is-unread")">
                                            <div class="ma-note-head">
                                                <strong>
                                                    @if (!note.IsRead)
                                                    {
                                                        <span class="ma-note-dot" aria-hidden="true"></span>
                                                    }
                                                    @note.Title
                                                    @if (!note.IsRead)
                                                    {
                                                        <span class="visually-hidden">(unread)</span>
                                                    }
                                                </strong>
                                                <time datetime="@note.CreatedAt.ToString("O")">@note.CreatedAt.ToString("dd MMM")</time>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(note.Content))
                                            {
                                                <p>@note.Content</p>
                                            }
                                            @if (!note.IsRead)
                                            {
                                                <button class="workspace-btn workspace-btn-secondary workspace-btn-small" type="button" disabled="@(markingId == note.Id)" @onclick="() => MarkReadAsync(note.Id)">@(markingId == note.Id ? "Marking…" : "Mark read")</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    </aside>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly HashSet<ApplicationStatus> InProgressStatuses =
    [
        ApplicationStatus.Pending,
        ApplicationStatus.Viewed,
        ApplicationStatus.Shortlisted,
        ApplicationStatus.Interviewing
    ];

    private bool isLoading = true;
    private bool isPageLoading;
    private bool hasLoadedOnce;
    private int? markingId;
    private int? withdrawConfirmId;
    private int? withdrawingId;
    private string? loadError;
    private string? actionMessage;
    private string? actionError;
    private MyApplicationsQuery query = new();
    private MyApplicationsPageDto pageResult = new();
    private List<MyNotificationDto> notifications = new();
    private CancellationTokenSource? searchDelay;

    private int unreadCount;
    private int TotalApplications => pageResult.TotalApplications;
    private int TotalCount => pageResult.TotalCount;
    private int InProgressCount => pageResult.InProgressCount;
    private int OfferCount => pageResult.OfferCount;
    private IReadOnlyList<MyApplicationDto> Applications => pageResult.Items;
    private int TotalPages => Math.Max(pageResult.TotalPages, 1);
    private int FirstShown => TotalCount == 0 ? 0 : (pageResult.Page - 1) * pageResult.PageSize + 1;
    private int LastShown => Math.Min(pageResult.Page * pageResult.PageSize, TotalCount);
    private bool HasFilters => !string.IsNullOrWhiteSpace(query.Search)
        || !string.IsNullOrWhiteSpace(query.StatusGroup);
    private string Summary => TotalCount == 0
        ? (HasFilters ? "No matches" : "0 total")
        : $"Showing {FirstShown}–{LastShown} of {TotalCount}{(HasFilters ? " matching" : string.Empty)}";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        if (AuthSession.IsAuthenticated)
        {
            await LoadAsync();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        searchDelay?.Cancel();
        searchDelay?.Dispose();
    }

    private static string InterviewStatusClass(InterviewStatus status) => status switch
    {
        InterviewStatus.Scheduled => "is-scheduled",
        InterviewStatus.Completed => "is-completed",
        InterviewStatus.Cancelled => "is-cancelled",
        _ => "is-muted"
    };

    private static string StatusClass(ApplicationStatus status) => status switch
    {
        ApplicationStatus.Pending => "is-pending",
        ApplicationStatus.Viewed => "is-viewed",
        ApplicationStatus.Shortlisted => "is-shortlisted",
        ApplicationStatus.Interviewing => "is-interviewing",
        ApplicationStatus.Offered => "is-offered",
        ApplicationStatus.Rejected => "is-rejected",
        _ => "is-withdrawn"
    };

    private async Task ClearFiltersAsync()
    {
        searchDelay?.Cancel();
        query.Search = string.Empty;
        query.StatusGroup = string.Empty;
        query.Page = 1;
        await LoadApplicationsAsync();
    }

    private async Task<string?> GetUserIdAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? state.User.FindFirstValue("sub");
    }

    private async Task LoadAsync()
    {
        if (isLoading && hasLoadedOnce)
        {
            return;
        }
        isLoading = true;
        hasLoadedOnce = true;
        loadError = null;
        try
        {
            await LoadApplicationsAsync();
            await LoadNotificationsAsync();
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadApplicationsAsync()
    {
        isPageLoading = true;
        loadError = null;
        try
        {
            var userId = await GetUserIdAsync();
            var result = await CircuitDbGate.RunAsync(
                () => CandidateService.GetMyApplicationsPageAsync(userId, query));
            if (!result.Success || result.Data is null)
            {
                loadError = result.Errors.FirstOrDefault() ?? "We could not load your applications.";
                return;
            }

            pageResult = result.Data;
            var lastPage = Math.Max(pageResult.TotalPages, 1);
            if (query.Page > lastPage)
            {
                // The last page disappeared (e.g. its only row was withdrawn): step back one page.
                query.Page = lastPage;
                result = await CircuitDbGate.RunAsync(
                    () => CandidateService.GetMyApplicationsPageAsync(userId, query));
                if (result.Success && result.Data is not null)
                {
                    pageResult = result.Data;
                }
            }
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
        finally
        {
            isPageLoading = false;
        }
    }

    private async Task LoadNotificationsAsync()
    {
        var userId = await GetUserIdAsync();
        var notes = await NotificationFeed.ListAsync(userId, 1, 20);
        if (notes.Success && notes.Data is not null)
        {
            notifications = notes.Data.Items.ToList();
            var unread = await NotificationFeed.UnreadCountAsync(userId);
            if (unread.Success)
            {
                unreadCount = unread.Data;
            }
        }
        else
        {
            actionError = notes.Errors.FirstOrDefault() ?? "We could not load your messages.";
        }
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        query.Search = args.Value?.ToString() ?? string.Empty;
        searchDelay?.Cancel();
        searchDelay?.Dispose();
        searchDelay = new CancellationTokenSource();
        var token = searchDelay.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!token.IsCancellationRequested)
        {
            await ApplyFiltersAsync();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        query.Page = 1;
        await LoadApplicationsAsync();
    }

    private async Task ChangePageAsync(int next)
    {
        if (isPageLoading || next < 1 || next > TotalPages)
        {
            return;
        }

        query.Page = next;
        await LoadApplicationsAsync();
    }

    private async Task MarkReadAsync(int notificationId)
    {
        actionMessage = actionError = null;
        markingId = notificationId;
        try
        {
            var notificationUserId = await GetUserIdAsync();
            var result = await NotificationFeed.MarkReadAsync(notificationUserId, notificationId);
            if (result.Success && result.Data is not null)
            {
                var index = notifications.FindIndex(note => note.Id == notificationId);
                if (index >= 0)
                {
                    notifications[index] = result.Data;
                    unreadCount = Math.Max(0, unreadCount - 1);
                }
                actionMessage = "Notification marked read.";
            }
            else
            {
                actionError = result.Errors.FirstOrDefault() ?? "Could not update this notification.";
            }
        }
        finally
        {
            markingId = null;
        }
    }

    private async Task WithdrawAsync(int applicationId)
    {
        actionMessage = actionError = null;
        withdrawingId = applicationId;
        try
        {
            var result = await CircuitDbGate.RunAsync(async () => await ApplicationService.WithdrawAsync(await GetUserIdAsync(), applicationId));
            withdrawConfirmId = null;
            if (!result.Success)
            {
                actionError = result.Errors.FirstOrDefault() ?? "We could not withdraw this application.";
                return;
            }

            await LoadApplicationsAsync();
            actionMessage = "Application withdrawn.";
        }
        catch (Exception exception)
        {
            actionError = exception.Message;
        }
        finally
        {
            withdrawingId = null;
        }
    }

}
