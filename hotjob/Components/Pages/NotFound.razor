@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | HotJob</PageTitle>

<section class="state-page" aria-labelledby="not-found-title">
    <p class="state-kicker">404 · Page not found</p>
    <h1 id="not-found-title">We could not find that page</h1>
    <p class="state-lede">The link may be out of date, or the page may have moved. Start from the job board or head back home.</p>
    <div class="state-actions">
        <a class="state-btn state-btn-primary" href="/it-jobs">Browse jobs</a>
        <a class="state-btn state-btn-secondary" href="/">Go home</a>
    </div>
</section>
