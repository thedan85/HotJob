@page "/login"
@layout RegisterLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using hotjob.DTOs.Authentication
@using hotjob.Services.Authentication
@inject HotJobAuthStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ILogger<LoginPage> Logger
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<PageTitle>Sign in | HotJob</PageTitle>

<div class="login-card">
    <section class="login-form-panel" aria-labelledby="login-title">
        <div class="login-form-inner">
            <div class="eyebrow"><span class="spark" aria-hidden="true">✦</span> Welcome back</div>
            <h1 id="login-title">Sign in to HotJob</h1>
            <p class="intro">Pick up where you left off and find your next opportunity.</p>

            @if (GoogleEnabled)
            {
                <a class="google-button" href="/api/auth/google">
                    <svg viewBox="0 0 48 48" aria-hidden="true">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    </svg>
                    Continue with Google
                </a>
                <div class="auth-divider"><span>or sign in with email</span></div>
            }

            <EditForm Model="form" OnValidSubmit="SubmitAsync" class="login-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                <div class="field-group">
                    <label for="login-email">Email</label>
                    <InputText id="login-email" type="email" @bind-Value="form.Email" placeholder="you@example.com" autocomplete="email" />
                    <ValidationMessage For="@(() => form.Email)" />
                </div>

                <div class="field-group">
                    <div class="field-label-row">
                        <label for="login-password">Password</label>
                        <a href="/">Forgot password?</a>
                    </div>
                    <div class="password-wrap">
                        <InputText id="login-password" type="@(showPassword ? "text" : "password")" @bind-Value="form.Password" placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button" class="password-toggle" @onclick="TogglePassword" aria-label="@(showPassword ? "Hide password" : "Show password")">@(showPassword ? "Hide" : "Show")</button>
                    </div>
                    <ValidationMessage For="@(() => form.Password)" />
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="form-message @(isSuccess ? "success" : "error")" role="alert">@message</div>
                }

                <button class="submit-button" type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Signing in..." : "Sign In")
                    <span aria-hidden="true">→</span>
                </button>
            </EditForm>

            <p class="login-prompt">New to HotJob? <a href="/register">Create an account</a></p>
        </div>
    </section>

    <aside class="login-benefits-panel" aria-label="HotJob benefits">
        <div class="login-benefits-inner">
            <p class="panel-kicker">Your next move starts here</p>
            <h2>Make work fit your life.</h2>
            <p>Keep your profile, saved jobs, and applications in one focused workspace.</p>
            <div class="login-points">
                <span><strong>01</strong>Personalized job matches</span>
                <span><strong>02</strong>Transparent salary signals</span>
                <span><strong>03</strong>Thoughtful company reviews</span>
            </div>
        </div>
    </aside>
</div>

@code {
    private readonly LoginRequest form = new();
    private bool isSubmitting;
    private bool isSuccess;
    private bool showPassword;
    private string? message;

    [SupplyParameterFromQuery(Name = "googleError")]
    private string? GoogleError { get; set; }

    private bool GoogleEnabled =>
        !string.IsNullOrWhiteSpace(Configuration["Google:ClientId"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Google:ClientSecret"]);

    protected override void OnInitialized()
    {
        if (GoogleError == "unavailable")
        {
            message = "Google sign-in is not configured yet.";
        }
        else if (!string.IsNullOrWhiteSpace(GoogleError))
        {
            message = "Google sign-in failed. Please try again or use your email and password.";
        }
    }

    private void TogglePassword() => showPassword = !showPassword;

    private async Task SubmitAsync()
    {
        message = null;
        isSuccess = false;
        isSubmitting = true;

        try
        {
            // Browser-originated fetch: the HttpOnly refresh cookie is set on the browser,
            // never through server-side HttpClient (which cannot deliver Set-Cookie to it).
            var result = await JS.InvokeAsync<AuthApiResult>("hotjobAuth.login", form.Email, form.Password);
            if (result.Ok && result.Data is not null)
            {
                AuthStateProvider.SignIn(result.ToTokens());
                NavigationManager.NavigateTo("/");
            }
            else
            {
                message = result.ErrorMessage;
            }
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Login request failed for {Email}.", form.Email);
            message = "We could not sign you in right now. Please try again.";
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Login failed for {Email}.", form.Email);
            message = "We could not sign you in right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
