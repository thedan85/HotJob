# Copy to .env.local and replace the values. Do not commit .env.local.
ConnectionStrings__DefaultConnection=Server=localhost;Database=hotjob;User=root;Password=;
Jwt__SecretKey=change-me-to-a-random-secret-at-least-32-chars
# VNPay sandbox. Leave empty to disable online checkout (the app still boots).
# ReturnUrl must match the running profile: http 5168 or https 7023.
# IpnUrl must be a public HTTPS URL; VNPay cannot call localhost.
VnPay__TmnCode=
VnPay__HashSecret=
VnPay__ReturnUrl=http://localhost:5168/api/vnpay/return
VnPay__IpnUrl=
# Preferred: seed N admin accounts (env names map to Seed:Admins list).
# Seed__Admins__0__Email=admin1@example.com
# Seed__Admins__0__Password=ChangeMe123!
# Seed__Admins__1__Email=admin2@example.com
# Seed__Admins__1__Password=ChangeMe123!
# Legacy single-admin fallback (still supported):
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=ChangeMe123!
# Optional demo accounts:
# Seed__Demo__CompanyName=Acme Corp
# Seed__Demo__EmployerEmail=employer@example.com
# Seed__Demo__EmployerPassword=Employer123!
# Seed__Demo__EmployerName=Demo Employer
Seed__Demo__CandidateEmail=candidate@example.com
Seed__Demo__CandidatePassword=Candidate123!
Seed__Demo__CandidateName=Demo Candidate